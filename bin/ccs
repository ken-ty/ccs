#!/bin/sh
#
# ccs — Claude Code セッションを tmux で立てる薄いラッパー。
#
# 設計の正本は docs/design.md。ここが持つのは 4 つだけ:
#   セッションの新規作成 / trust ダイアログの回避 / パス解決 / 命名規約と後片付け
# 一覧・状態・セッション間通信は Claude Code の組み込みに委譲する。

set -eu

CCS_VERSION='0.0.3'

# ---------------------------------------------------------------------------
# 出力
#
# 人間向けのメッセージは stderr に出す。stdout は機械可読な結果だけに使う
# （`ccs new` の JSON、`ccs ls --json`、`ccs hub status --json`）。混ぜると
# ハブ側でパースできなくなる。
#
# **この 2 つだけは設定より先に定義する。** 設定ファイルの読み込み自体が
# 警告を出すため。
# ---------------------------------------------------------------------------
warn() {
	printf '%s\n' "$*" >&2
}

die() {
	_code=$1
	shift
	warn "ccs: $*"
	exit "$_code"
}

# ---------------------------------------------------------------------------
# 設定（差し替え点）
#
# **優先順位は env > 設定ファイル > 既定値。**
#
# 設定ファイルは `${XDG_CONFIG_HOME:-~/.config}/ccs/config`（`CCS_CONFIG_FILE`
# で移動できる）。`KEY=VALUE` を 1 行 1 つ、`#` 以降はコメント。値の先頭の
# `~/` はホームに展開する。
#
#   # ~/.config/ccs/config
#   CCS_HUB_SLUG=orchestrator   # hub という名前のリポジトリを持っている人向け
#   CCS_HUB_AUTOSTART=off       # 自動起動を入れない
#
# **書けるキーは CCS_CONFIG_KEYS に列挙したものだけ。** 知らないキーは黙って
# 無視せず警告する（綴り間違いが「設定したのに効かない」で終わるのを防ぐ）。
# ファイルを sh として source しないのも同じ理由で、設定ファイルに任意の
# コマンドを書けてしまうと、設定と実行の境界が無くなる。
#
# テストはここを差し替えることで、本物の claude を起動せず、本物の
# ~/.claude.json を書き換えずに済ませる（AGENTS.md「テストの方針」）。
# **新しく外部コマンドや外部パスに触るときは、必ずここに差し替え点を
# 足してから使うこと。**
# ---------------------------------------------------------------------------

: "${CCS_CONFIG_FILE:=${XDG_CONFIG_HOME:-${HOME}/.config}/ccs/config}"

CCS_CONFIG_KEYS='
CCS_PREFIX
CCS_CLAUDE_BIN
CCS_TMUX_BIN
CCS_GHQ_BIN
CCS_GIT_BIN
CCS_JQ_BIN
CCS_PS_BIN
CCS_SESSIONS_DIR
CCS_TRUST_FILE
CCS_SCRATCH_ROOT
CCS_SCRATCH_SLOTS
CCS_PROJECTS_DIR
CCS_NEW_TIMEOUT
CCS_RESTORE_MAX_AGE
CCS_REMOTE_CONTROL
CCS_HUB_SLUG
CCS_HUB_HOME
CCS_HUB_RC_TIMEOUT
CCS_HUB_BACKOFF_WINDOW
CCS_HUB_BACKOFF_MAX
CCS_HUB_AUTOSTART
CCS_HUB_AGENT_LABEL
CCS_HUB_AGENT_INTERVAL
'

# どこから来た値かを覚えておく（`ccs config` が出す）。
# 「設定したのに効かない」を人が自力で切り分けられるようにするための情報。
config_mark_env_sources() {
	for _k in $CCS_CONFIG_KEYS; do
		if eval "[ \"\${${_k}+set}\" = set ]"; then
			eval "CCS_SRC_${_k}=env"
		else
			eval "CCS_SRC_${_k}=default"
		fi
	done
}

config_key_is_known() {
	for _k in $CCS_CONFIG_KEYS; do
		[ "$_k" = "$1" ] && return 0
	done
	return 1
}

config_trim() {
	printf '%s' "$1" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
}

load_config() {
	[ -f "$CCS_CONFIG_FILE" ] || return 0
	[ -r "$CCS_CONFIG_FILE" ] || {
		warn "ccs: 設定ファイルを読めません（無視して続けます）: ${CCS_CONFIG_FILE}"
		return 0
	}

	_lineno=0
	# `|| [ -n "$_line" ]` は、最終行に改行が無いファイルを取りこぼさないため。
	while IFS= read -r _line || [ -n "$_line" ]; do
		_lineno=$((_lineno + 1))
		_line=${_line%%#*}
		_line=$(config_trim "$_line")
		[ -n "$_line" ] || continue

		case $_line in
		*=*) ;;
		*)
			warn "ccs: ${CCS_CONFIG_FILE}:${_lineno}: KEY=VALUE の形ではありません: ${_line}"
			continue
			;;
		esac

		_key=$(config_trim "${_line%%=*}")
		_val=$(config_trim "${_line#*=}")

		# 値の囲みクォートを外す。KEY="~/foo bar" と書けるようにするため。
		case $_val in
		\"*\") _val=${_val#\"}; _val=${_val%\"} ;;
		\'*\') _val=${_val#\'}; _val=${_val%\'} ;;
		esac

		case $_val in
		\~/*) _val="${HOME}/${_val#\~/}" ;;
		esac

		if ! config_key_is_known "$_key"; then
			warn "ccs: ${CCS_CONFIG_FILE}:${_lineno}: 知らない設定キーです: ${_key}"
			warn '  設定できるキーの一覧: ccs config'
			continue
		fi

		# **env が勝つ。** 一時的に環境変数で上書きして試す、が成立しなくなる。
		_src=''
		eval "_src=\${CCS_SRC_${_key}}"
		[ "$_src" = 'env' ] && continue

		eval "${_key}=\$_val"
		# shellcheck disable=SC2163  # 変数名が変数なのは意図どおり（キーは白名簿で検査済み）
		export "$_key"
		eval "CCS_SRC_${_key}=config"
	done <"$CCS_CONFIG_FILE"
}

config_mark_env_sources
load_config

# --- 既定値 ---------------------------------------------------------------

: "${CCS_CLAUDE_BIN:=claude}"
: "${CCS_TMUX_BIN:=tmux}"
: "${CCS_GHQ_BIN:=ghq}"
: "${CCS_GIT_BIN:=git}"
: "${CCS_JQ_BIN:=jq}"
: "${CCS_PS_BIN:=ps}"
: "${CCS_SESSIONS_DIR:=${HOME}/.claude/sessions}"
: "${CCS_TRUST_FILE:=${HOME}/.claude.json}"
: "${CCS_SCRATCH_ROOT:=${HOME}/.cc-scratch}"

: "${CCS_PROJECTS_DIR:=${HOME}/.claude/projects}"

# tmux セッション名の接頭辞。手で開いた tmux セッションを巻き込まないための境界。
: "${CCS_PREFIX:=cc/}"

# 起動してからレジストリに載るまで待つ秒数。
#
# 本物は起動に数秒かかる（トラストダイアログで止まると永遠に載らない）。
# 短すぎると健全な起動を失敗と誤判定し、長すぎると詰まりに気づくのが遅れる。
: "${CCS_NEW_TIMEOUT:=30}"

# 使い捨て作業枠の本数。
#
# **枠を有限にするのが目的**（docs/design.md §4.4）。使い捨てセッションが
# 無限に増えないための歯止めで、いまはこれが唯一の根拠。
#
# **trust の回避は理由ではない。** 当初は「枠なら人が最初の 1 回だけ信頼
# すれば済む」と書いていたが、それは 2026-08-18 に成り立たなくなった ──
# 信頼は `ensure_trust` が起動前に書き込むので、渡すディレクトリが
# 作りたてでも構わない（実測。docs/adr/0001-scratch-workspace-identity.md）。
#
# **この固定枠そのものをやめる決定が出ている**（ADR-0001）。有限性は枠数
# ではなく確実な後片付けで担保し、セッションごとに一意なディレクトリを配る。
: "${CCS_SCRATCH_SLOTS:=8}"

# `ccs restore` が黙って拾う会話ログの古さの上限（日）。0 なら無制限。
#
# **「止まった」と「終わった」を分ける線。** 会話ログは消えないので、上限が
# 無いと数か月前に使い終えた枠まで復元候補に並ぶ。再起動の直後に戻したいのは
# さっきまで動いていたものなので、既定は短くてよい。
#
# 効くのは**列挙するときだけ** ── 名前で指したもの（`ccs restore tmp-3`）は
# どれだけ古くても戻す。人が名前を打っているなら、それが意図。
: "${CCS_RESTORE_MAX_AGE:=7}"

# Remote Control（スマホ・デスクトップからセッションを触る仕組み）の扱い。
#
#   auto … hub だけに `--remote-control <名前>` を渡す（既定）
#   on   … ccs が立てる全セッションに渡す
#   off  … 一切渡さない。hub の健全性判定でも RC を要求しない
#
# **off を用意しているのは、RC を使わない・使えない環境があるため。**
# その環境で hub の健全性が常に no-rc になると、自動再起動が永久に空回りする。
: "${CCS_REMOTE_CONTROL:=auto}"

# --- hub -------------------------------------------------------------------
#
# hub は「スマホから唯一触る 1 本」。落ちると ccs を叩く経路ごと消えるので、
# 名前・置き場所・自動起動を全部設定で変えられるようにしてある。
# 詳細は docs/hub.md。

# hub の slug。tmux では `<CCS_PREFIX><CCS_HUB_SLUG>` になる。
# **`hub` というリポジトリを持っている人はここを変える。**
: "${CCS_HUB_SLUG:=hub}"

# hub の作業ディレクトリ。ccs が作り、CLAUDE.md と権限設定を置く。
: "${CCS_HUB_HOME:=${HOME}/.cc-hub}"

# Remote Control の登録（bridgeSessionId）が付くまで待つ秒数。
: "${CCS_HUB_RC_TIMEOUT:=45}"

# 再起動の暴走を止める窓（秒）と、その窓で許す再起動の回数。
#
# **無限再起動は課金とレート制限に直結する。** 直っていないものを 5 分ごとに
# 立て直し続けるより、止まって人を待つほうがいい。
: "${CCS_HUB_BACKOFF_WINDOW:=600}"
: "${CCS_HUB_BACKOFF_MAX:=3}"

# 自動起動（launchd / systemd）の設定。`ccs hub agent` が読む。
#
#   on    … ログイン時 + 一定間隔で `ccs hub up`（既定）
#   login … ログイン時だけ
#   off   … 生成しない（手で `ccs hub up` を叩く運用）
: "${CCS_HUB_AUTOSTART:=on}"
: "${CCS_HUB_AGENT_LABEL:=local.ccs.hub}"
: "${CCS_HUB_AGENT_INTERVAL:=300}"

# ---------------------------------------------------------------------------
# 終了コード
#
# 呼び出し側（ハブのエージェント、launchd）が分岐できるよう、意味を固定する。
# **これは対外的な契約なので、まだ使っていない番号も消さない。**
# ---------------------------------------------------------------------------
EX_OK=0       # 成功
EX_FAIL=1     # 一般的な失敗
EX_USAGE=2    # 使い方の誤り（未知のサブコマンド、引数不足）
# shellcheck disable=SC2034  # v2 以降のサブコマンドのために番号を空けてある
EX_TODO=3     # 未実装
EX_DEPS=4     # 依存コマンドが無い

# hub の状態。`ccs hub status` の終了コードであり、`ccs hub up` が
# 「直せなかった理由」を返すときの値でもある（docs/hub.md の表）。
EX_HUB_NO_RC=10        # claude は生きているが Remote Control が付いていない
EX_HUB_STOPPED=11      # ペインは残っているが claude が死んでいる
EX_HUB_ABSENT=12       # tmux セッションごと無い
EX_HUB_NEEDS_LOGIN=13  # 認証が切れている（人が /login するしかない）
EX_HUB_PAUSED=14       # 人が意図的に止めている
EX_HUB_ATTENTION=15    # 再起動を繰り返している（backoff 発動）

# ---------------------------------------------------------------------------
# 使い方
# ---------------------------------------------------------------------------

usage() {
	cat <<'EOF'
ccs — Claude Code セッションを tmux で立てる薄いラッパー

使い方:
  ccs new <target> [-- <初期プロンプト>]  セッションを立てる
  ccs new <repo>@<branch> [-- ...]        worktree を切ってそこに立てる
  ccs new --tmp [-- <初期プロンプト>]     使い捨ての作業枠に立てる
  ccs ls [--json]                         ccs のセッションを一覧する
  ccs ls -l [--json]                      盤面（直近の依頼 / RSS / 最終更新）も出す
  ccs attach [<slug>]                     セッションに乗り込む
                                          （slug を省くと番号で選ぶ）
  ccs kill [--force] <slug>               セッションを畳む
                                          （作業中は --force が要る）
  ccs gc [--yes]                          止まったセッション・空の作業枠・不要な worktree を掃除する
                                          （既定は見せるだけ。--yes で実行）
  ccs restore [--yes] [<slug>...]         止まった／消えたセッションを同じ会話で
                                          立て直す（既定は見せるだけ）
  ccs restore <slug> --list               その場所に残っている会話を並べる

  ccs hub up [--force] [--quiet]          hub を立てる（生きていれば何もしない）
  ccs hub status [--json]                 hub の状態を見る（終了コードで分岐できる）
  ccs hub restart [--resume]              hub を立て直す（--resume で同じ会話）
  ccs hub down                            hub を止める（自動起動も止まる）
  ccs hub attach                          hub に乗り込む
  ccs hub agent [--print]                 自動起動（launchd / systemd）の設定を出す

  ccs resolve <target> [--json]           <target> がどこに解決されるかを見る
  ccs resolve --tmp [--json]              次に取る作業枠を見る
  ccs config [--json]                     効いている設定と、その出どころを見る
  ccs help                                このヘルプ
  ccs version                             バージョン

<target>:
  <repo>        ghq 配下のリポジトリ名（例: x01）
  <path>        絶対パスまたは相対パス
  <repo>@<branch>
                そのリポジトリの worktree（無ければ作る）。
                同じリポジトリに 2 本以上のセッションを立てる唯一の手段。
                置き場所は <repo>/.worktrees/<branch>（リポジトリ配下）
  tmp           使い捨ての作業枠（--tmp の短い綴り。ghq に tmp という
                リポジトリがあるときは曖昧なので受け付けない）

設定:
  env > 設定ファイル > 既定値 の順で効く。設定ファイルは
  ${XDG_CONFIG_HOME:-~/.config}/ccs/config（KEY=VALUE を 1 行 1 つ）。

  よく変えるもの:
    CCS_HUB_SLUG       hub の名前            [既定: hub]
                       （hub という名前のリポジトリを持っている人はここを変える）
    CCS_HUB_HOME       hub の作業ディレクトリ [既定: ~/.cc-hub]
    CCS_HUB_AUTOSTART  自動起動 on/login/off [既定: on]
    CCS_REMOTE_CONTROL Remote Control auto/on/off [既定: auto]
    CCS_PREFIX         tmux 名の接頭辞       [既定: cc/]
    CCS_SCRATCH_SLOTS  使い捨て作業枠の本数  [既定: 8]

  いま効いている値と出どころは `ccs config` で見られる。
  一覧と意味は docs/configuration.md、hub の運用は docs/hub.md。
EOF
}

# ---------------------------------------------------------------------------
# 依存チェック
#
# help / version では走らせない。**依存が無いことを知るためにヘルプを読むので、
# ヘルプが依存チェックで死ぬと詰む。**
# ---------------------------------------------------------------------------
have() {
	command -v "$1" >/dev/null 2>&1
}

require_deps() {
	_missing=''
	have "$CCS_TMUX_BIN" || _missing="${_missing} ${CCS_TMUX_BIN}"
	have "$CCS_JQ_BIN" || _missing="${_missing} ${CCS_JQ_BIN}"

	[ -z "$_missing" ] && return 0

	warn "ccs: 必要なコマンドが見つかりません:${_missing}"
	warn ''
	warn '  macOS: brew install tmux jq'
	warn '  Debian/Ubuntu: sudo apt install tmux jq'
	warn ''
	warn '別の場所にあるなら CCS_TMUX_BIN / CCS_JQ_BIN で指定できます。'
	exit "$EX_DEPS"
}

# ---------------------------------------------------------------------------
# 対象の解決
#
# <target> を「絶対パス」と「slug」の 2 つに落とす。slug は tmux セッション名・
# Claude の表示名・ログの見出しで同じものを使う唯一の識別子
# （docs/design.md §4.2）。ここがブレると名寄せが全部ブレる。
#
# 結果は CCS_RESOLVED_PATH / CCS_RESOLVED_SLUG に入る。
# ---------------------------------------------------------------------------

CCS_RESOLVED_PATH=''
CCS_RESOLVED_SLUG=''
CCS_RESOLVED_WORKTREE_REPO=''
CCS_RESOLVED_WORKTREE_BRANCH=''

# tmux セッション名として安全な形にする。
#
# tmux 3.7 は `.` も `:` も名前に受け付けてしまうが、`:` は
# `session:window` の区切りなので、後から -t で狙えなくなる。
# 受け付けられることと安全であることは別。
sanitize_slug() {
	printf '%s' "$1" | sed 's/[^A-Za-z0-9_@-]/-/g'
}

json_str() {
	printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"
}

# 実在するディレクトリを絶対パスに正規化する。
# realpath / readlink -f は環境差が大きいので使わない。
abs_dir() {
	(cd "$1" 2>/dev/null && pwd -P) || return 1
}

# そのパスが linked worktree なら、本体の作業ツリーとブランチを
# CCS_WT_MAIN / CCS_WT_BRANCH に入れて 0 を返す。違えば 1。
#
# **git に訊く。パスの形からは判断しない**（ADR-0003 決定 3）。
# 置き場所の前方一致で当てていた頃は、規約の外に置かれた worktree を
# 取りこぼし、実パスで指されると素性が分からなかった（ADR-0002 表 #9）。
# **パスもまた名前**なので、同一性の根拠にしない。
path_is_linked_worktree() {
	CCS_WT_MAIN=''
	CCS_WT_BRANCH=''

	# **安い門番。** linked worktree の `.git` は**ファイル**（通常の
	# リポジトリはディレクトリ）。`ccs restore` は ghq 配下を全部舐めるので、
	# 大多数を git を起こさずに落とせることが効く。
	[ -f "${1}/.git" ] || return 1
	have "$CCS_GIT_BIN" || return 1

	# **linked worktree だけが、git-dir と common-dir が食い違う。**
	# 前者は `.git/worktrees/<名前>`、後者は常に本体の `.git`。
	#
	# **submodule をここで落とす。** あちらも `.git` はファイルだが、
	# 自分が本体なので両者が一致する。`git worktree list` で判定しては
	# **いけない** ── submodule の中から呼ぶと、あれは作業ツリーではなく
	# **git-dir**（`.git/modules/<名前>`）を先頭に並べるので、
	# `--show-toplevel` と比べると食い違って worktree に見える（実測）。
	#
	# 両方 `pwd -P` を通す。片方だけ生のままだと、symlink を挟む環境
	# （macOS の /tmp）で食い違いが出る。
	_wt_gd=$(cd "$1" 2>/dev/null &&
		cd "$("$CCS_GIT_BIN" rev-parse --git-dir 2>/dev/null)" 2>/dev/null && pwd -P) || return 1
	_wt_cd=$(cd "$1" 2>/dev/null &&
		cd "$("$CCS_GIT_BIN" rev-parse --git-common-dir 2>/dev/null)" 2>/dev/null && pwd -P) || return 1
	[ "$_wt_gd" != "$_wt_cd" ] || return 1

	# ここまで来たら本物の linked worktree。**一覧の先頭が本体**
	# （git が保証している）。
	_wt_main=$("$CCS_GIT_BIN" -C "$1" worktree list --porcelain 2>/dev/null |
		sed -n '1s/^worktree //p')
	[ -n "$_wt_main" ] || return 1

	# bare リポジトリの worktree では、先頭は作業ツリーではなく
	# リポジトリそのもの。素性として名乗れないので使わない。
	[ -d "${_wt_main}/.git" ] || return 1

	# 分離 HEAD は枝を名乗れない。素性が半分しか無いものを素性として扱わない。
	_wt_br=$("$CCS_GIT_BIN" -C "$1" rev-parse --abbrev-ref HEAD 2>/dev/null) || return 1
	[ -n "$_wt_br" ] && [ "$_wt_br" != 'HEAD' ] || return 1

	CCS_WT_MAIN=$_wt_main
	CCS_WT_BRANCH=$_wt_br
	return 0
}

# ghq 配下で <basename> が複数あるかを見る。
# 衝突していれば slug に owner を足す（design.md §4.2）。
repo_basename_is_ambiguous() {
	_base=$1
	_n=$("$CCS_GHQ_BIN" list 2>/dev/null |
		awk -F/ -v b="$_base" '$NF == b' | wc -l | tr -d ' ')
	[ "${_n:-0}" -gt 1 ]
}

# 絶対パスから slug を決める。
#
# 基本は末尾要素だが、ghq 配下で名前が衝突しているなら <owner>-<repo> にする。
# **利用者がどう打ったか（repo か owner/repo か）に依らず同じ slug になる**
# ことが大事 — 打ち方で別セッションが立つと、冪等性 (S5) が成立しない。
slug_for_path() {
	_path=$1
	_base=$(basename "$_path")

	# **linked worktree は `<repo>@<branch>` と名乗る**（ADR-0003 決定 3）。
	#
	# これが無いと、同じディレクトリが打ち方で 2 つの slug に割れる ──
	# `ccs new <worktree の実パス>` は末尾要素を、`ccs new <repo>@<branch>` は
	# `<repo>@<branch>` を返し、**1 つの作業ツリーに 2 本の claude が立つ**。
	# 冪等性 (S5、design.md §4.3) の穴。
	#
	# 本体の slug を出す再帰はコマンド置換（＝サブシェル）なので、
	# CCS_WT_* を踏まない。本体は linked ではないので 1 段で止まる。
	if path_is_linked_worktree "$_path"; then
		_wt_repo_slug=$(slug_for_path "$CCS_WT_MAIN")
		printf '%s@%s\n' "$_wt_repo_slug" "$(branch_slug "$CCS_WT_BRANCH")"
		return 0
	fi

	# 作業枠を実パスで指されたとき。末尾要素は `1` なので、そのままだと
	# `cc/1` という無意味なセッションが立ち、`ccs new tmp` で立てたものと
	# 別物になってしまう。枠は枠として名乗らせる。
	_scratch_abs=$(abs_dir "$CCS_SCRATCH_ROOT" 2>/dev/null || printf '%s' "$CCS_SCRATCH_ROOT")
	case $_path in
	"${_scratch_abs}"/*)
		if [ "$(dirname "$_path")" = "$_scratch_abs" ]; then
			printf 'tmp-%s\n' "$(sanitize_slug "$_base")"
			return 0
		fi
		;;
	esac

	# **hub と同じ名前のリポジトリは、owner を足して避ける。**
	# `cc/<hub>` は hub のものなので、他のリポジトリに使わせると、
	# 立てた瞬間に hub の生死判定が壊れる。
	if repo_basename_is_ambiguous "$_base" ||
		[ "$(sanitize_slug "$_base")" = "$(sanitize_slug "$CCS_HUB_SLUG")" ]; then
		_owner=$(basename "$(dirname "$_path")")
		sanitize_slug "${_owner}-${_base}"
	else
		sanitize_slug "$_base"
	fi
}

resolve_as_path() {
	_p=$1
	[ -d "$_p" ] || die "$EX_FAIL" "そのディレクトリはありません: ${_p}"
	CCS_RESOLVED_PATH=$(abs_dir "$_p") ||
		die "$EX_FAIL" "ディレクトリを解決できません: ${_p}"
	CCS_RESOLVED_SLUG=$(slug_for_path "$CCS_RESOLVED_PATH")
}

resolve_as_repo() {
	_q=$1

	have "$CCS_GHQ_BIN" ||
		die "$EX_FAIL" "リポジトリ名で指定するには ghq が要ります（${CCS_GHQ_BIN} が見つかりません）。パスで指定してください"

	# 末尾一致で引く。`x01` でも `ken-ty/x01` でも
	# `github.com/ken-ty/x01` でも同じように当たる。
	# 正規表現を組み立てないのは、リポジトリ名に含まれる記号を
	# エスケープし損ねる事故を避けるため。
	_matches=$("$CCS_GHQ_BIN" list -p 2>/dev/null |
		awk -v q="/$_q" 'index($0, q) == length($0) - length(q) + 1')

	_count=$(printf '%s' "$_matches" | grep -c . || true)

	case ${_count:-0} in
	0)
		warn "ccs: ghq にそのリポジトリはありません: ${_q}"
		warn ''
		warn '  手元にあるか確認: ghq list | grep -i '"${_q}"
		warn '  取ってくる:       ghq get <owner>/<repo>'
		warn '  パスで指定しても構いません: ccs new /path/to/repo'
		exit "$EX_FAIL"
		;;
	1)
		resolve_as_path "$_matches"
		;;
	*)
		warn "ccs: ${_q} に当てはまるリポジトリが複数あります:"
		warn ''
		printf '%s\n' "$_matches" | while IFS= read -r _m; do
			[ -n "$_m" ] || continue
			warn "  $(basename "$(dirname "$_m")")/$(basename "$_m")"
		done
		warn ''
		warn '<owner>/<repo> の形で指定し直してください。'
		exit "$EX_FAIL"
		;;
	esac
}

# ---------------------------------------------------------------------------
# worktree（`ccs new <repo>@<branch>`）
#
# **1 リポジトリに 2 本目のセッションを立てるための唯一の手段。**
# slug はリポジトリ名なので（design.md §4.2）、同じリポジトリを 2 回頼まれても
# 冪等に 1 本目が返る。タスクごとにセッションを立てたいなら、作業ツリーごと
# 分けるしかない（design.md §9.1）。
#
# 置き場所は **リポジトリ配下の `<repo>/.worktrees/<branch-slug>`**
# （ADR-0003 決定 1）。slug は `<repo-slug>@<branch-slug>`（design.md §4.2）。
# ---------------------------------------------------------------------------

# ブランチ名を slug に落とす。`feat/foo` → `feat-foo`。
#
# **slug とディレクトリ名を一致させ続けるため**（ADR-0003 決定 5）。
# 掘らないのは「`feat` と `feat/foo` が同居できないから」ではない ── その 2 つは
# **git 自身が共存を禁じる**（`refs/heads/` はファイルの階層。実測）。
#
# **潰したことで生まれる衝突のほうが実在する。** `feat-foo` と `feat/foo` は
# 共存でき、どちらも同じディレクトリに落ちる。`ensure_worktree` が
# 既存の `HEAD` を見て食い違いを落とす。
branch_slug() {
	sanitize_slug "$1"
}

# <target> を repo 部とブランチ部に割る。**最後の `@` で割る。**
# リポジトリ名に `@` が入ることはあるが、ブランチ名の `@` より後ろに来ない。
worktree_split_repo() {
	printf '%s' "${1%@*}"
}

worktree_split_branch() {
	printf '%s' "${1##*@}"
}

# worktree を置くディレクトリの名前。**リポジトリ直下に掘る。**
#
# **ドット始まりは飾りではない**（ADR-0003 決定 1）。gitignore を読まない道具
# （`go build ./...`・pytest の `norecursedirs`・各種 analyzer・`rg` の hidden
# 既定）が軒並みドット始まりを既定で飛ばす。`.gitignore` 系の防御と独立した
# 二重の防御になる。
CCS_WORKTREE_DIR='.worktrees'

# その worktree があるべき絶対パス。**worktree 自体は作らない。**
#
# `$1` は本体のリポジトリの絶対パス。ghq 配下かどうかは問わない
# ── 判定は「git リポジトリか」だけ（ADR-0003 決定 1）。
worktree_path_for() {
	printf '%s/%s/%s\n' "$1" "$CCS_WORKTREE_DIR" "$(branch_slug "$2")"
}

# 本体の `.git/info/exclude` に `.worktrees/` を足す。冪等。
#
# **`.gitignore` ではなくここに書く**（ADR-0003 決定 2）。あちらは追跡対象なので、
# 先方のリポジトリや fork にこちらの都合で差分を作ることになる
# （グローバル AGENTS.md「自分が所有しないコードベース」）。ここは追跡外で、
# **`--git-common-dir` は全 worktree 共有**なので 1 回書けば入れ子も塞がる（実測）。
#
# これが無いと `git status` に `?? .worktrees/` が出るだけでなく、
# **`git add -A` が nested worktree を gitlink としてコミットに載せる**（実測）。
# エージェントが日常的に打つ形なので、事故として現実的。
worktree_exclude_add() {
	_ex_repo=$1
	_ex_line="/${CCS_WORKTREE_DIR}/"

	# **既に追跡されているなら、そこは利用者の場所。** 触らずに落とす。
	if "$CCS_GIT_BIN" -C "$_ex_repo" ls-files --error-unmatch \
		"$CCS_WORKTREE_DIR" >/dev/null 2>&1; then
		warn "ccs: ${CCS_WORKTREE_DIR} は既にこのリポジトリで追跡されています: ${_ex_repo}"
		warn ''
		warn '  そこは ccs の場所ではありません。worktree を切る先がありません。'
		exit "$EX_FAIL"
	fi

	_ex_common=$(cd "$_ex_repo" 2>/dev/null &&
		cd "$("$CCS_GIT_BIN" rev-parse --git-common-dir 2>/dev/null)" 2>/dev/null &&
		pwd -P) || return 0
	_ex_file="${_ex_common}/info/exclude"

	# 既にあるなら何もしない。行の完全一致で見る。
	if [ -f "$_ex_file" ] && grep -qxF "$_ex_line" "$_ex_file" 2>/dev/null; then
		return 0
	fi

	mkdir -p "${_ex_common}/info" 2>/dev/null || return 0

	# **末尾に改行が無いファイルを壊さない。** そのまま追記すると
	# 最終行に連結されて、両方の行が効かなくなる。
	if [ -s "$_ex_file" ] && [ -n "$(tail -c 1 "$_ex_file" 2>/dev/null)" ]; then
		printf '\n' >>"$_ex_file" || return 0
	fi
	printf '%s\n' "$_ex_line" >>"$_ex_file" || return 0
}

# `<repo>@<branch>` を解決する。**ここでは作らない。**
#
# 作業枠（`--tmp`）は「空いている枠はどれか」で識別子が決まるので、
# 解決の時点で枠を取る（＝ディレクトリを作る）必要がある。worktree は
# repo と branch から一意に決まるので、その必要が無い。
# **実体を作るのは `ccs new` だけ**（`ccs resolve` に副作用を持たせない）。
resolve_as_worktree() {
	_target=$1
	_repo_q=$(worktree_split_repo "$_target")
	_branch=$(worktree_split_branch "$_target")

	[ -n "$_repo_q" ] ||
		die "$EX_USAGE" "worktree の指定に対象がありません: ${_target}（<repo>@<branch> の形で書きます）"
	[ -n "$_branch" ] ||
		die "$EX_USAGE" "worktree の指定にブランチがありません: ${_target}（<repo>@<branch> の形で書きます）"

	# repo 部は通常の解決に通す。`x01@feat` でも `ken-ty/x01@feat` でも
	# `/path/to/x01@feat` でも同じ worktree に落ちる。
	case $_repo_q in
	/* | ./* | ../*) resolve_as_path "$_repo_q" ;;
	*)
		if [ -d "$_repo_q" ]; then
			resolve_as_path "$_repo_q"
		else
			resolve_as_repo "$_repo_q"
		fi
		;;
	esac

	_repo_path=$CCS_RESOLVED_PATH
	_repo_slug=$CCS_RESOLVED_SLUG

	# **worktree を指されたら、本体に読み替える**（ADR-0003 決定 4）。
	#
	# 拒否ではなく読み替えにするのは、**入れ子を「起こり得なくする」ため**。
	# 拒否は人が打ち直す前提の設計で、`.worktrees/a/.worktrees/b` を作れる形は
	# 残ったままになる。読み替えれば原理的に生まれない。
	#
	# slug も自動で正しくなる ── `<repo-slug>` は**本体**から決まるので、
	# 拒否する設計だと、正しい slug を得るために呼び出し側が本体のパスを
	# 知っていることを要求してしまう。worktree の中で走っているセッションが
	# 兄弟タスクを立てるとき、自然な綴りは `.@bar` や `$PWD@bar` のほう。
	#
	# **主経路（`ghq list` 経由）はここに来ない** ── ghq は worktree を
	# 列挙しないので、repo 部は必ず本体に解決される（ADR-0003 の実測）。
	if path_is_linked_worktree "$_repo_path"; then
		_repo_path=$CCS_WT_MAIN
		_repo_slug=$(slug_for_path "$_repo_path")
		warn "ccs: 本体のリポジトリに読み替えました: ${_repo_path}"
	fi

	CCS_RESOLVED_WORKTREE_REPO=$_repo_path
	CCS_RESOLVED_WORKTREE_BRANCH=$_branch
	CCS_RESOLVED_PATH=$(worktree_path_for "$_repo_path" "$_branch")
	CCS_RESOLVED_SLUG="${_repo_slug}@$(branch_slug "$_branch")"
}

# 解決済みの worktree を実在させる。冪等。
#
# **既にあるものは作り直さない。** 作り直すと、そこに残っている未コミットの
# 作業が消える。`git worktree add` は既存のディレクトリを拒むので、
# 先に「もう worktree として登録されているか」を見る。
# worktree の生成に失敗したときの出口。
#
# **git の文言をそのまま流すだけにしない。** 版や環境で変わるうえ、
# 「で、次に何を打てばいいのか」がどの版にも書かれていない。
worktree_add_failed() {
	warn "ccs: worktree を作れませんでした: $2"
	warn ''
	printf '%s\n' "$3" >&2
	warn ''
	warn "  同じ名前のブランチが他の worktree で開かれているかもしれません:"
	warn "    ${CCS_GIT_BIN} -C $(shq "$1") worktree list"
	exit "$EX_FAIL"
}

ensure_worktree() {
	_repo=$1
	_branch=$2
	_path=$3

	have "$CCS_GIT_BIN" ||
		die "$EX_FAIL" "worktree を使うには git が要ります（${CCS_GIT_BIN} が見つかりません）"

	"$CCS_GIT_BIN" -C "$_repo" rev-parse --git-dir >/dev/null 2>&1 ||
		die "$EX_FAIL" "git リポジトリではありません: ${_repo}"

	# 既にある。ここで戻るのが冪等性の本体。
	if [ -d "$_path" ]; then
		"$CCS_GIT_BIN" -C "$_path" rev-parse --git-dir >/dev/null 2>&1 ||
			die "$EX_FAIL" "worktree のあるべき場所に、git 管理下でないものがあります: ${_path}"

		# **別のブランチが座っていないか見る**（ADR-0003 決定 5）。
		# `branch_slug` は `/` を `-` に潰すので、`feat/foo` と `feat-foo` は
		# **共存できるのに同じディレクトリに落ちる**（git は前者どうしの
		# `feat` と `feat/foo` は禁じるが、この 2 つは禁じない。実測）。
		# 黙って別のブランチの作業ツリーを渡すと、そこで書いたものが
		# 意図しない枝に乗る。
		_have=$("$CCS_GIT_BIN" -C "$_path" rev-parse --abbrev-ref HEAD 2>/dev/null) || _have=''
		if [ -n "$_have" ] && [ "$_have" != "$_branch" ]; then
			warn "ccs: そこには別のブランチの worktree があります: ${_path}"
			warn ''
			warn "  そこにあるのは ${_have}、指定されたのは ${_branch} です。"
			warn '  どちらかの名前を変えてください（ディレクトリ名は / を - に潰します）。'
			exit "$EX_FAIL"
		fi
		return 0
	fi

	# **`.worktrees/` を git から隠すのは、実体を作る前。** 先に worktree が
	# 生えると、その一瞬 `git status` と `git add -A` に晒される。
	worktree_exclude_add "$_repo"

	mkdir -p "$(dirname "$_path")" ||
		die "$EX_FAIL" "worktree の置き場所を作れません: $(dirname "$_path")"

	# ブランチが既にあるなら開く、無ければ作る。
	# **既存ブランチを -b で作ろうとすると落ちる**ので、先に見る。
	#
	# **失敗したときの案内は両方に要る。** git は 1 ブランチにつき 1 worktree しか
	# 許さないので、「他所で開かれている」はブランチが既にあるときにこそ起きる。
	# 以前は -b 側にしか案内が無く、その本命の経路が無言で落ちていた。
	if "$CCS_GIT_BIN" -C "$_repo" show-ref --verify --quiet "refs/heads/${_branch}"; then
		_out=$("$CCS_GIT_BIN" -C "$_repo" worktree add "$_path" "$_branch" 2>&1) ||
			worktree_add_failed "$_repo" "$_path" "$_out"
		warn "ccs: 既存のブランチ ${_branch} を ${_path} に開きました。"
	else
		_out=$("$CCS_GIT_BIN" -C "$_repo" worktree add -b "$_branch" "$_path" 2>&1) ||
			worktree_add_failed "$_repo" "$_path" "$_out"
		warn "ccs: ブランチ ${_branch} を作って ${_path} に開きました。"
	fi

	# **追跡されていないものは付いてこない**（node_modules・.env・ビルド成果物）。
	# 「元では動くのに worktree でだけ落ちる」の原因になるので先に言う。
	warn '     追跡されていないファイル（依存・.env・ビルド成果物）は入っていません。'
}

dir_is_empty() {
	[ -d "$1" ] || return 1
	# 隠しファイルも数える。.git だけ残った枠を「空」と見なすと、
	# 前の作業の痕跡が次のセッションに漏れる。
	_n=$(find "$1" -mindepth 1 -maxdepth 1 2>/dev/null | head -1)
	[ -z "$_n" ]
}

# 使い捨て作業枠を 1 つ確保する。
#
# 空いている枠 = ディレクトリが空 **かつ** その枠にセッションが立っていない。
#
# セッションの有無まで見るのは、`ccs new tmp` が「新しい使い捨て」を求める
# 指示だから。まだ何も書いていない作業中のセッションは中身が空なので、
# ディレクトリだけを見ると、動いているセッションを掴んで返してしまう。
resolve_as_scratch() {
	mkdir -p "$CCS_SCRATCH_ROOT" ||
		die "$EX_FAIL" "作業枠を作れません: ${CCS_SCRATCH_ROOT}"

	_i=1
	while [ "$_i" -le "$CCS_SCRATCH_SLOTS" ]; do
		_slot="${CCS_SCRATCH_ROOT}/${_i}"

		if tmux_session_exists "${CCS_PREFIX}tmp-${_i}"; then
			_i=$((_i + 1))
			continue
		fi

		if [ ! -e "$_slot" ] || dir_is_empty "$_slot"; then
			mkdir -p "$_slot" || die "$EX_FAIL" "作業枠を作れません: ${_slot}"
			CCS_RESOLVED_PATH=$(abs_dir "$_slot")
			CCS_RESOLVED_SLUG="tmp-${_i}"
			return 0
		fi

		_i=$((_i + 1))
	done

	warn "ccs: 使い捨ての作業枠が全部埋まっています（${CCS_SCRATCH_ROOT} に ${CCS_SCRATCH_SLOTS} 本）"
	warn ''
	warn '  使い終わったものを片付ける: ccs gc'
	warn '  個別に畳む:                 ccs kill tmp-<番号>'
	warn ''
	warn '枠を増やすなら CCS_SCRATCH_SLOTS。ただし枠が有限であること自体が'
	warn '使い捨てセッションを増やしすぎないための歯止めです。'
	exit "$EX_FAIL"
}

# 予約語 `tmp` が ghq のリポジトリ名と衝突していないか。
#
# `tmp` は使い捨て枠を指す予約語だが、target の名前空間はリポジトリ名と
# 共有している。`ghq get someone/tmp` をした瞬間、`ccs new tmp` がどちらを
# 指すのかは打った人にしか分からない ── IceCubesApp の衝突と同じ性質なので、
# 同じように候補を出して止める。
#
# **`--tmp` は名前空間の外にあるので、この衝突とは無縁。** だから枠が欲しい
# ときの正式な綴りは `--tmp` のほう。
CCS_SCRATCH_WORD_HITS=''
scratch_word_conflicts() {
	have "$CCS_GHQ_BIN" || return 1
	CCS_SCRATCH_WORD_HITS=$("$CCS_GHQ_BIN" list -p 2>/dev/null |
		awk -F/ '$NF == "tmp"')
	[ -n "$CCS_SCRATCH_WORD_HITS" ]
}

resolve_target() {
	_target=$1

	# 引用符付きで `~/foo` が渡ってきたときのため。通常はシェルが先に展開する。
	case $_target in
	\~/*) _target="${HOME}/${_target#\~/}" ;;
	esac

	# hub は予約語。**リポジトリ名と名前空間を共有しているので、
	# 同名のリポジトリを持っている人がいる前提で扱う。**
	if [ "$_target" = "$CCS_HUB_SLUG" ]; then
		warn "ccs: ${CCS_HUB_SLUG} は hub を指す予約語です。"
		warn ''
		warn '  hub を立てる:           ccs hub up'
		warn "  同名のリポジトリを開く: ccs new <owner>/${CCS_HUB_SLUG}"
		warn '  hub の名前を変える:     設定ファイルに CCS_HUB_SLUG=<別名>'
		warn ''
		warn 'いま効いている設定: ccs config'
		exit "$EX_FAIL"
	fi

	case $_target in
	*@*)
		# **実在するディレクトリが優先。** `@` を含むディレクトリ名は
		# 珍しくない（`foo@2` など）。実物があるならそれを指している。
		if [ -d "$_target" ]; then
			resolve_as_path "$_target"
		else
			resolve_as_worktree "$_target"
		fi
		;;
	tmp)
		if scratch_word_conflicts; then
			warn 'ccs: tmp は使い捨ての作業枠を指す予約語ですが、同名のリポジトリもあります:'
			warn ''
			printf '%s\n' "$CCS_SCRATCH_WORD_HITS" | while IFS= read -r _m; do
				[ -n "$_m" ] || continue
				warn "  $(basename "$(dirname "$_m")")/$(basename "$_m")"
			done
			warn ''
			warn '  作業枠が欲しい:     ccs new --tmp'
			warn '  リポジトリが欲しい: ccs new <owner>/tmp'
			exit "$EX_FAIL"
		fi
		resolve_as_scratch
		;;
	/* | ./* | ../*)
		resolve_as_path "$_target"
		;;
	*)
		# 相対パスとして実在するならパス優先。`ken-ty/x01` のように
		# ghq の指定とも相対パスとも読める形があるため、実物を優先する。
		if [ -d "$_target" ]; then
			resolve_as_path "$_target"
		else
			resolve_as_repo "$_target"
		fi
		;;
	esac

	if [ -z "$CCS_RESOLVED_PATH" ] || [ -z "$CCS_RESOLVED_SLUG" ]; then
		die "$EX_FAIL" "対象を解決できませんでした: ${_target}"
	fi
}

# ---------------------------------------------------------------------------
# サブコマンド
#
# 中身は S4 以降で埋める（ROADMAP 参照）。ここでは分岐だけを固定する。
# ---------------------------------------------------------------------------

cmd_resolve() {
	_json=''
	_target=''
	_want_scratch=''

	while [ $# -gt 0 ]; do
		case $1 in
		--json) _json=1 ;;
		--tmp) _want_scratch=1 ;;
		-*) die "$EX_USAGE" "resolve: 知らないオプション: $1" ;;
		*) _target=$1 ;;
		esac
		shift
	done

	if [ -n "$_want_scratch" ]; then
		[ -z "$_target" ] ||
			die "$EX_USAGE" "resolve: --tmp と <target> は同時に指定できません: ${_target}"
		resolve_as_scratch
	else
		[ -n "$_target" ] ||
			die "$EX_USAGE" 'resolve: <target> を指定してください（使い捨ての作業枠は --tmp）'
		resolve_target "$_target"
	fi

	if [ -n "$_json" ]; then
		printf '{"slug":%s,"path":%s}\n' \
			"$(json_str "$CCS_RESOLVED_SLUG")" \
			"$(json_str "$CCS_RESOLVED_PATH")"
	else
		printf '%s\t%s\n' "$CCS_RESOLVED_SLUG" "$CCS_RESOLVED_PATH"
	fi
}

# ---------------------------------------------------------------------------
# workspace trust
#
# 対話モードの claude は、初めて見るディレクトリで信頼確認を出して止まる
# （実測。docs/design.md §2.6）。止まっている間はレジストリにすら現れないので、
# tmux 越しに立てると 30 秒待って失敗するだけになる。
#
# 方針（design.md §4.4、2026-08-17 の決定）:
#
#   ghq 配下のリポジトリ … 自動で信頼済みにする。人が意図して clone した
#                          ものなので、ここでの確認は情報を増やさない
#   空の使い捨て作業枠   … 自動で信頼済みにする（#6、2026-08-18 の決定）。
#                          枠は ccs 自身が作った空のディレクトリなので、確認が
#                          守ろうとしている「知らないコード」がそもそも無い。
#                          手作業にすると枠 8 本ぶん承認が要り、tmp を何本も
#                          立てる運用が実質できなくなる（実機で踏んだ）
#   それ以外             … 自動で承認しない。確認が出ることを先に伝えて進む
#
# **安全確認をツールが黙って潰さない**のがこの分け方の要点。中身のあるところは
# ghq 配下でない限り自分で答えてもらう。
# ---------------------------------------------------------------------------

trust_is_accepted() {
	_p=$1
	[ -f "$CCS_TRUST_FILE" ] || return 1
	# shellcheck disable=SC2016  # $p は jq の変数。シェルに展開させてはいけない
	_v=$("$CCS_JQ_BIN" -r --arg p "$_p" \
		'.projects[$p].hasTrustDialogAccepted // false' "$CCS_TRUST_FILE" 2>/dev/null) || return 1
	[ "$_v" = 'true' ]
}

path_is_under_ghq() {
	have "$CCS_GHQ_BIN" || return 1
	_root=$("$CCS_GHQ_BIN" root 2>/dev/null) || return 1
	[ -n "$_root" ] || return 1

	# **root も symlink を辿った形にする。** 比較相手のパスは pwd -P を
	# 通っているので、片方だけ生のままだと前方一致が外れる。macOS の
	# /var → /private/var で実際に外れた。
	_root=$(abs_dir "$_root" 2>/dev/null || printf '%s' "$_root")

	case $1 in
	"$_root"/*) return 0 ;;
	esac
	return 1
}

# hub の作業ディレクトリか。
#
# ccs が作り、ccs と使う人しか触らない場所なので、ghq 配下と同じ理由で
# 自動承認してよい（**中身が空である必要は無い** — ccs 自身が CLAUDE.md と
# 権限設定を置くため）。
path_is_hub_home() {
	_home=$(abs_dir "$CCS_HUB_HOME" 2>/dev/null) || return 1
	[ "$1" = "$_home" ]
}

# 使い捨て作業枠のうち、いま空のものか。
#
# **空であることを毎回確かめる**のがこの判定の要点。枠を渡すのは
# `resolve_as_scratch` が空だと確かめたときだけだが、中身の入った枠を
# 実パスで指されることはある。そのときは他所と同じく自動承認しない
# ── そこにあるのは誰かが置いたコードなので、確認する意味がある。
path_is_scratch_slot() {
	_scratch_root=$(abs_dir "$CCS_SCRATCH_ROOT" 2>/dev/null) || return 1
	[ "$(dirname "$1")" = "$_scratch_root" ] || return 1
	dir_is_empty "$1"
}

# ghq 配下のリポジトリの worktree か。
#
# **元のリポジトリが ghq 配下なら、その worktree も信頼してよい。**
# そこにあるのは人が意図して clone したリポジトリの中身そのもので、
# 信頼確認が守ろうとしている「知らないコード」ではない（design.md §4.4 の
# ghq と同じ理由）。これが無いと、タスクごとに worktree を切る運用で
# **毎回 30 秒の信頼確認に固まる**。
#
# **素性は git から引く**（ADR-0003 決定 3）。以前は置き場所の前方一致＋
# 「解決のときに立てた変数」で当てていたので、**実パスで指されると判定
# できなかった**（ADR-0002 表 #9）── 同じディレクトリが、打ち方によって
# 信頼されたりされなかったりしていた。
path_is_ghq_worktree() {
	path_is_linked_worktree "$1" || return 1
	path_is_under_ghq "$CCS_WT_MAIN"
}

# hasTrustDialogAccepted を立てる。
#
# **~/.claude.json は Claude Code の状態がまとめて入っている 100KB 級の
# ファイルで、壊すと本体が動かなくなる。** 触る以上、次を全部やる:
#
#   1. 書く前に、入力が妥当な JSON であることを確かめる
#   2. 一時ファイルに書き、それも妥当な JSON か確かめる
#   3. projects のキーが減っていないことを確かめる（取りこぼしの検出）
#   4. そこまで通って初めて mv で置き換える（原子的）
#
# どれか 1 つでも落ちたら、元のファイルには触らずに諦める。
trust_accept() {
	_p=$1

	if [ -f "$CCS_TRUST_FILE" ]; then
		"$CCS_JQ_BIN" -e . "$CCS_TRUST_FILE" >/dev/null 2>&1 ||
			die "$EX_FAIL" "${CCS_TRUST_FILE} が妥当な JSON ではないため、触りません"
		_before=$("$CCS_JQ_BIN" -r '.projects // {} | length' "$CCS_TRUST_FILE")
	else
		mkdir -p "$(dirname "$CCS_TRUST_FILE")" 2>/dev/null || true
		printf '{}\n' >"$CCS_TRUST_FILE"
		_before=0
	fi

	_tmp="${CCS_TRUST_FILE}.ccs.$$"

	# shellcheck disable=SC2016  # $p は jq の変数。シェルに展開させてはいけない
	"$CCS_JQ_BIN" --arg p "$_p" \
		'.projects //= {} | .projects[$p] //= {} | .projects[$p].hasTrustDialogAccepted = true' \
		"$CCS_TRUST_FILE" >"$_tmp" 2>/dev/null || {
		rm -f "$_tmp"
		die "$EX_FAIL" "${CCS_TRUST_FILE} を更新できませんでした"
	}

	if ! "$CCS_JQ_BIN" -e . "$_tmp" >/dev/null 2>&1; then
		rm -f "$_tmp"
		die "$EX_FAIL" "更新後の内容が妥当な JSON になりませんでした。元のファイルは触っていません"
	fi

	_after=$("$CCS_JQ_BIN" -r '.projects // {} | length' "$_tmp")
	if [ "$_after" -lt "$_before" ]; then
		rm -f "$_tmp"
		die "$EX_FAIL" "更新で projects の項目が減りました（${_before} → ${_after}）。元のファイルは触っていません"
	fi

	mv "$_tmp" "$CCS_TRUST_FILE"
}

# 立てる前に信頼状態を整える。落とさない ── 判断材料を出して進む。
ensure_trust() {
	_p=$1

	trust_is_accepted "$_p" && return 0

	if path_is_under_ghq "$_p"; then
		trust_accept "$_p"
		warn "ccs: ghq 配下なので信頼済みにしました: ${_p}"
		return 0
	fi

	if path_is_ghq_worktree "$_p"; then
		trust_accept "$_p"
		warn "ccs: ghq 配下のリポジトリの worktree なので信頼済みにしました: ${_p}"
		return 0
	fi

	if path_is_scratch_slot "$_p"; then
		trust_accept "$_p"
		warn "ccs: 空の使い捨て作業枠なので信頼済みにしました: ${_p}"
		return 0
	fi

	if path_is_hub_home "$_p"; then
		trust_accept "$_p"
		warn "ccs: hub の作業ディレクトリなので信頼済みにしました: ${_p}"
		return 0
	fi

	# 自動で承認しない場所。確認が出ることを先に言う ── 黙って立てると、
	# 30 秒待たされて「登録されませんでした」とだけ言われることになる。
	warn "ccs: ${_p} はまだ信頼されていません。"
	warn '起動時に信頼確認が出ます。一度答えれば以後は出ません:'
	warn "  ccs attach ${2:-<slug>}   # 「1. Yes, I trust this folder」を選ぶ"
	warn ''
}

# ---------------------------------------------------------------------------
# セッションを立てる
# ---------------------------------------------------------------------------

# シェルコマンドの一部として安全に埋め込める形にする。
#
# tmux にはコマンドを文字列で渡すので、ここを手抜きすると、空白や引用符を
# 含むパスで壊れる。パスは利用者が決めるものなので、必ず通す。
shq() {
	printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

# セッション ID を先に決める。
#
# 本物は --session-id を尊重する（docs/design.md §2.4）。先に決めておくと、
# 起動直後にレジストリを名前で探し回らずに済み、transcript の場所も
# 起動前に確定する。
new_uuid() {
	if have uuidgen; then
		uuidgen | tr '[:upper:]' '[:lower:]'
		return 0
	fi

	if [ -r /proc/sys/kernel/random/uuid ]; then
		cat /proc/sys/kernel/random/uuid
		return 0
	fi

	# uuidgen が無い環境向け。version/variant のビットまで整えておく ──
	# 本物は「有効な UUID であること」を検証するため。
	_hex=$(od -An -tx1 -N16 /dev/urandom | tr -d ' \n')
	[ ${#_hex} -eq 32 ] || die "$EX_FAIL" 'セッション ID を生成できません'

	_b6=$(printf '4%s' "$(printf '%s' "$_hex" | cut -c14-16)")
	_b8=$(printf '%s' "$_hex" | cut -c17-20 |
		sed 's/^./8/')

	printf '%s-%s-%s-%s-%s\n' \
		"$(printf '%s' "$_hex" | cut -c1-8)" \
		"$(printf '%s' "$_hex" | cut -c9-12)" \
		"$_b6" "$_b8" \
		"$(printf '%s' "$_hex" | cut -c21-32)"
}

# transcript の置き場所。
#
# 実測した本物の規則: 絶対パスの英数字以外をすべて `-` に潰す
#   /Users/apple/ghq/github.com/ken-ty/collection_deck_ja
#     → -Users-apple-ghq-github-com-ken-ty-collection-deck-ja
#
# **これは予測したパスであって、この時点ではまだファイルは無い。**
# 本物は最初のやり取りが発生してから .jsonl を作る（実測）。
# 立てた直後に読もうとすると必ず失敗するので、そのつもりで扱うこと。
transcript_path() {
	printf '%s/%s.jsonl\n' "$(transcript_dir_for "$1")" "$2"
}

# その cwd の会話ログが溜まるディレクトリ。
#
# **規則を使うのは前向きだけ。** ディレクトリ名から元のパスは復元できない
# （「立て直す」の節を見ること）。
transcript_dir_for() {
	printf '%s/%s\n' "$CCS_PROJECTS_DIR" \
		"$(printf '%s' "$1" | sed 's/[^A-Za-z0-9]/-/g')"
}

tmux_session_exists() {
	"$CCS_TMUX_BIN" has-session -t "=${1}" 2>/dev/null
}

# レジストリに <uuid> が現れるまで待つ。
#
# 固定の sleep で済ませない。速いマシンでは無駄に待ち、遅いマシンでは
# 取りこぼす。見つかったら即座に返す。
wait_for_registration() {
	_uuid=$1
	_deadline=$(($(date +%s) + CCS_NEW_TIMEOUT))

	while [ "$(date +%s)" -lt "$_deadline" ]; do
		if registry_file_for "$_uuid" >/dev/null; then
			return 0
		fi
		sleep 0.2
	done

	return 1
}

# <uuid> を持つレジストリファイルのパスを出す。無ければ 1 を返す。
registry_file_for() {
	_uuid=$1
	for _f in "$CCS_SESSIONS_DIR"/*.json; do
		[ -e "$_f" ] || continue
		if grep -q "\"sessionId\":\"${_uuid}\"" "$_f" 2>/dev/null; then
			printf '%s\n' "$_f"
			return 0
		fi
	done
	return 1
}

emit_session_json() {
	printf '{"slug":%s,"sessionId":%s,"path":%s,"tmux":%s,"transcript":%s,"created":%s,"running":%s}\n' \
		"$(json_str "$1")" "$(json_str "$2")" "$(json_str "$3")" \
		"$(json_str "$4")" "$(json_str "$5")" "$6" "$7"
}

# <slug> のセッションが書いたレジストリファイルを引く。無ければ 1 を返す。
#
# レジストリの tmux フィールドは `cc/<slug>:<window>.<pane>` の形なので、
# `cc/<slug>:` を前方一致で探す。slug 単体で探すと `x01` が `x011` に
# 当たるので、区切りの `:` まで含めて見る。
registry_file_for_slug() {
	_slug=$1
	for _f in "$CCS_SESSIONS_DIR"/*.json; do
		[ -e "$_f" ] || continue
		if grep -q "\"tmux\":\"${CCS_PREFIX}${_slug}:" "$_f" 2>/dev/null; then
			registry_is_live "$_f" || continue
			printf '%s\n' "$_f"
			return 0
		fi
	done
	return 1
}

# そのレジストリファイルを書いたプロセスが、まだ生きているか。
#
# **残骸を「生きている」と読まない。** claude は終了時に自分のファイルを消すが、
# SIGKILL やクラッシュでは消えずに残る。残骸を信じると、hub は永久に healthy に
# 見えたまま二度と戻らない ── 自動復帰の意味が消える。
registry_is_live() {
	_pid=$(sed -n 's/.*"pid":\([0-9]*\).*/\1/p' "$1" 2>/dev/null | head -1)
	[ -n "$_pid" ] || return 1
	kill -0 "$_pid" 2>/dev/null
}

# 立っているセッションの sessionId を引く。
live_session_id_for() {
	_f=$(registry_file_for_slug "$1") || return 1
	registry_field "$_f" sessionId
}

# claude が終了したあとの sessionId を、ペインの起動コマンドから拾う。
#
# **`ccs restore` の入力であり、手で復帰するときの唯一の導線でもある。**
# ペインを `exec $SHELL` で残しているおかげで、起動コマンドの文字列も残る。
# **`--resume` で立てたペインも読む。** `ccs restore` と `ccs hub restart
# --resume` は `--session-id` ではなく `--resume` で立てるので、片方しか見ないと
# 一度戻したセッションの uuid が二度目から引けない（`ccs ls` の stopped 行が
# `-` になり、復帰の手掛かりが消える）。`\|` は BSD sed に無いので式を 2 つに分ける。
pane_session_id_for() {
	_session=$1
	"$CCS_TMUX_BIN" list-panes -t "$_session" -F '#{pane_start_command}' 2>/dev/null |
		sed -n \
			-e "s/.*--session-id '\{0,1\}\([0-9a-f-]\{36\}\).*/\1/p" \
			-e "s/.*--resume '\{0,1\}\([0-9a-f-]\{36\}\).*/\1/p" |
		head -1
}

# 立っているセッションの cwd を引く。取れなければ空。
live_cwd_for() {
	_f=$(registry_file_for_slug "$1") || return 1
	registry_field "$_f" cwd
}

# 立っているセッションの Remote Control 登録（bridgeSessionId）を引く。
#
# **付いていないとスマホのアプリに出ない。** 実測で、対話セッションとしては
# 正常なのに bridgeSessionId が null のまま残ることがある。hub にとっては
# 「アプリから見えない = 実質死んでいる」なので、生死判定の材料にする。
live_bridge_for() {
	_f=$(registry_file_for_slug "$1") || return 1
	_b=$(registry_field "$_f" bridgeSessionId)
	[ -n "$_b" ] || return 1
	printf '%s\n' "$_b"
}

cmd_new() {
	require_deps

	_target=''
	_prompt=''
	_want_scratch=''

	while [ $# -gt 0 ]; do
		case $1 in
		--)
			shift
			_prompt=$*
			break
			;;
		--tmp) _want_scratch=1 ;;
		-*) die "$EX_USAGE" "new: 知らないオプション: $1" ;;
		*)
			[ -z "$_target" ] || die "$EX_USAGE" "new: <target> は 1 つだけです: ${_target} と $1"
			_target=$1
			;;
		esac
		shift
	done

	if [ -n "$_want_scratch" ]; then
		[ -z "$_target" ] ||
			die "$EX_USAGE" "new: --tmp と <target> は同時に指定できません: ${_target}"
		resolve_as_scratch
		# 以降の案内文（`ccs kill <slug> && ccs new <target>`）で使う。
		_target='--tmp'
	else
		[ -n "$_target" ] ||
			die "$EX_USAGE" 'new: <target> を指定してください（使い捨ての作業枠は --tmp。ccs help を見てください）'
		resolve_target "$_target"
	fi

	_slug=$CCS_RESOLVED_SLUG
	_path=$CCS_RESOLVED_PATH
	_session="${CCS_PREFIX}${_slug}"

	# 冪等。**同じ slug を 2 度頼まれたら、立て直さず既にあるものを返す。**
	# ハブは「その名前のセッションが欲しい」と言っているのであって、
	# 「必ず新しく作れ」と言っているわけではない。二重に立てると、
	# 同じ作業ツリーを 2 本の claude が触ることになる。
	if tmux_session_exists "$_session"; then
		if _existing=$(live_session_id_for "$_slug"); then
			_cwd=$(live_cwd_for "$_slug" || printf '%s' "$_path")
			[ -n "$_cwd" ] || _cwd=$_path
			emit_session_json "$_slug" "$_existing" "$_cwd" "$_session" \
				"$(transcript_path "$_cwd" "$_existing")" false true
			return 0
		fi

		# ペインは残っているが claude は動いていない。ハブは会話相手を
		# 求めているので、これを成功として返すと嘘になる。
		_stale=$(pane_session_id_for "$_session")
		warn "ccs: ${_session} のペインは残っていますが、claude は動いていません。"
		warn ''
		if [ -n "$_stale" ]; then
			warn '  同じ会話で立て直す:'
			warn "    ccs restore ${_slug} --yes"
			warn '  中を見てから決める:'
			warn "    ccs attach ${_slug}   # そこで claude --resume ${_stale}"
		else
			warn "  乗り込んで確かめる: ccs attach ${_slug}"
		fi
		warn "  畳んで立て直す:     ccs kill ${_slug} && ccs new ${_target}"
		exit "$EX_FAIL"
	fi

	# **worktree の実体はここで初めて作る。** 解決（`ccs resolve`）に
	# 副作用を持たせないため。既に立っているセッションを返す場合はここへ
	# 来ないので、無駄な worktree も生えない。
	if [ -n "$CCS_RESOLVED_WORKTREE_REPO" ]; then
		ensure_worktree "$CCS_RESOLVED_WORKTREE_REPO" \
			"$CCS_RESOLVED_WORKTREE_BRANCH" "$_path"
	fi

	ensure_trust "$_path" "$_slug"

	_uuid=$(new_uuid)
	_transcript=$(transcript_path "$_path" "$_uuid")

	# claude が終了してもペインを残す（design.md §4.3）。残しておけば
	# あとから同じ場所で `claude --resume <uuid>` を流し込める。
	_cmd="$(shq "$CCS_CLAUDE_BIN") -n $(shq "$_slug") --session-id $(shq "$_uuid")"
	[ -n "$_prompt" ] && _cmd="${_cmd} $(shq "$_prompt")"
	_cmd="${_cmd}; exec $(shq "${SHELL:-/bin/sh}")"

	"$CCS_TMUX_BIN" new-session -d -s "$_session" -c "$_path" sh -c "$_cmd" ||
		die "$EX_FAIL" "tmux セッションを作れませんでした: ${_session}"

	if ! wait_for_registration "$_uuid"; then
		warn "ccs: ${CCS_NEW_TIMEOUT} 秒待ちましたが、セッションが登録されませんでした。"
		warn ''
		warn 'ペインの中身:'
		warn '---'
		"$CCS_TMUX_BIN" capture-pane -p -t "$_session" 2>/dev/null | tail -20 >&2 || true
		warn '---'
		warn ''
		warn '起動途中で何かを尋ねられている可能性があります（信頼確認・ログインなど）。'
		warn "  乗り込んで確かめる: ccs attach ${_slug}"
		warn "  諦めて畳む:         ccs kill ${_slug}"
		# **ここでセッションを消さない。** 消すと、何に詰まっていたのかが
		# 分からなくなる。片付けるかどうかは人が決める。
		exit "$EX_FAIL"
	fi

	emit_session_json "$_slug" "$_uuid" "$_path" "$_session" "$_transcript" true true
}

# ---------------------------------------------------------------------------
# 一覧
#
# **`claude agents --json` では絞れない。** 実測したところ、あちらの出力は
# cwd / kind / name / pid / sessionId / startedAt だけで、**tmux フィールドを
# 持たない**（それはレジストリのファイル側にしか無い）。したがって
# 「cc/ で始まるセッション」をあの出力から選び出すことはできない。
#
# 代わりに tmux を起点にする。`cc/` が付いているのは ccs が立てたものだけ
# なので、そこは ccs の管轄として正しい。各セッションの中身
# （sessionId・status・cwd）はレジストリのファイルから引く。
# ---------------------------------------------------------------------------

# ccs が立てた tmux セッションの slug を、名前順に並べる。
list_slugs() {
	"$CCS_TMUX_BIN" list-sessions -F '#{session_name}' 2>/dev/null |
		sed -n "s|^${CCS_PREFIX}||p" |
		sort
}

registry_field() {
	sed -n "s/.*\"$2\":\"\([^\"]*\)\".*/\1/p" "$1"
}

# レジストリの数値フィールド（`"pid":14060` のように引用符が付かない値）。
# `registry_field` は文字列専用なので pid は引けない。
registry_num_field() {
	sed -n "s/.*\"$2\":\([0-9][0-9]*\).*/\1/p" "$1"
}

# 表示用にホーム配下を ~ に畳む。
tilde_path() {
	case $1 in
	"$HOME"/*) printf '~%s' "${1#"$HOME"}" ;;
	*) printf '%s' "$1" ;;
	esac
}

# 1 セッションぶんの情報を集めて、タブ区切りで 1 行出す。
#   slug<TAB>status<TAB>sessionId<TAB>path
collect_session_row() {
	_slug=$1
	_session="${CCS_PREFIX}${_slug}"
	_file=''

	# **残骸を「生きている」と読まない**（`registry_is_live` と同じ理由）。
	# claude は終了時に自分のファイルを消すが、SIGKILL やシグナル死では
	# 残る。残骸を掴むと、**死んでいるセッションを `idle` と表示し、
	# 立て直したあとも古い sessionId を出し続ける**。
	for _f in "$CCS_SESSIONS_DIR"/*.json; do
		[ -e "$_f" ] || continue
		if grep -q "\"tmux\":\"${_session}:" "$_f" 2>/dev/null; then
			registry_is_live "$_f" || continue
			_file=$_f
			break
		fi
	done

	if [ -n "$_file" ]; then
		_id=$(registry_field "$_file" sessionId)
		_status=$(registry_field "$_file" status)
		[ -n "$_status" ] || _status='running'
		_path=$(registry_field "$_file" cwd)
		_pid=$(registry_num_field "$_file" pid)
	else
		# claude は動いていない。**ここで uuid を落とすと復帰路が消える** ──
		# v1 に resume が無いので、手で `claude --resume` するしかない。
		_status='stopped'
		_id=$(pane_session_id_for "$_session")
		[ -n "$_id" ] || _id='-'
		_path=$("$CCS_TMUX_BIN" list-panes -t "$_session" -F '#{pane_current_path}' 2>/dev/null | head -1)
		# claude が動いていないので pid は無い。`_id` / `_path` と同じく
		# `-` を置く ── **タブ区切りの行に空の欄を作らない**ため。IFS に
		# タブを入れて `read` すると、連続したタブは 1 つの区切りとして
		# 潰れる（POSIX: タブは IFS の空白文字）ので、空欄を運ぶと
		# 後ろの列が 1 つずつ手前にずれる。
		_pid='-'
	fi

	[ -n "$_path" ] || _path='-'
	printf '%s\t%s\t%s\t%s\t%s\n' "$_slug" "$_status" "$_id" "$_path" "$_pid"
}

ls_as_json() {
	_rows=$1
	printf '['
	_first=1
	printf '%s\n' "$_rows" | while IFS="$(printf '\t')" read -r _slug _status _id _path _pid; do
		[ -n "$_slug" ] || continue
		[ "$_first" = 1 ] || printf ','
		_first=0
		printf '{"slug":%s,"status":%s,"sessionId":%s,"path":%s,"tmux":%s}' \
			"$(json_str "$_slug")" "$(json_str "$_status")" \
			"$(json_str "$_id")" "$(json_str "$_path")" \
			"$(json_str "${CCS_PREFIX}${_slug}")"
	done
	printf ']\n'
}

ls_as_table() {
	_rows=$1

	# slug の最大幅に合わせる。固定幅だと長い slug で崩れる。
	_w=$(printf '%s\n' "$_rows" |
		awk -F'\t' 'NF && length($1) > m { m = length($1) } END { print (m < 4 ? 4 : m) }')

	printf "%-${_w}s  %-8s  %-36s  %s\n" 'SLUG' 'STATUS' 'SESSION ID' 'PATH'
	printf '%s\n' "$_rows" | while IFS="$(printf '\t')" read -r _slug _status _id _path _pid; do
		[ -n "$_slug" ] || continue
		printf "%-${_w}s  %-8s  %-36s  %s\n" \
			"$_slug" "$_status" "$_id" "$(tilde_path "$_path")"
	done
}

# ---------------------------------------------------------------------------
# 盤面（`ccs ls -l`）
#
# ハブが「いまどのセッションが何をしているか」を 1 コマンドで取り直すための
# 列。**既定の `ccs ls` には足さない** ── 会話ログを舐める分だけ確実に遅く
# なり、「立っているものを知りたいだけ」の用途に払わせる理由が無い。
#
# 足すのは 3 つだけ:
#   直近の依頼 — 会話ログの最後の user メッセージ（ツール結果と定型文は除く）
#   RSS        — その claude プロセスの実メモリ（畳むかどうかの判断材料）
#   最終更新   — 会話ログの mtime からの経過
#
# **ここは 4 責務の外に出ない。** 出すのは ccs が既に知っている場所
# （`transcript_path`）とレジストリの `pid` から読めるものだけで、会話の
# 中身を解釈しない（`ccs` はタスクを知らない ── AGENTS.md）。
# ---------------------------------------------------------------------------

# 「人が打った依頼」だけに当たる形。
#
# 実測（会話ログ 40 本 / `"type":"user"` の行 291 本）: user 行は 3 通りしか無い。
#   {"role":"user","content":"…"}                                人が打った依頼
#   {"role":"user","content":[{"type":"text",…}]}                人が打った依頼（添付つき等）
#   {"role":"user","content":[{"tool_use_id"…  /  [{"type":"tool_result"…  ツール結果
# 前 2 つだけを引けば、ツール結果は 1 件も混ざらない（実測で 0 件）。
#
# **`grep -F` を 2 パターン並べるより、ERE 1 本のほうが速い。** 実測
# （macOS 15 / BSD grep / 50MB の会話ログ）: `-F` × 2 で 0.58 秒、ERE 1 本で
# 0.30 秒。`-F` に複数パターンを渡すと BSD grep は照合器を切り替えるが、
# ERE ならこのパターンは先頭が固定文字列なので、そこで弾ける。
#
# `[{]` と `[[]` を使うのは、`\{` の扱いが BRE/ERE と実装で揺れるため。
# 括弧式に入れれば、どちらでもただの文字になる。
CCS_LS_USER_RE='"message":[{]"role":"user","content":("|[[][{]"type":"text")'

# 直近の依頼の表示幅。**文字数ではなく桁数**（全角は 2 桁として数える）。
# 文字数で切ると、日本語の依頼が横 140 桁になって 1 画面に収まらない。
CCS_LS_REQUEST_WIDTH=70

# 末尾から何本の候補まで遡って定型文を読み飛ばすか。
CCS_LS_REQUEST_CANDIDATES=12

# 候補の行から「人が打った依頼」を 1 行取り出す jq。
#
# **定型文を落とす。** 暫定のハブ用スクリプトでは
# `[Request interrupted by user]` やスラッシュコマンドの展開
# （`<command-name>…`）、スキルの注入（`Base directory for this skill:`）が
# そのまま「直近の依頼」として出ていた。人が何を頼んだかを知るための列なので、
# 人が打っていないものは候補から外す。
#
# **先に `.[:400]` で切る。** 依頼そのものが数十 KB あることは珍しくなく、
# その全長に `gsub` と `explode` を掛けると **1 本あたり 0.2 秒**かかる
# （実測。15 本で 3 秒 ── 低コストという要件がそこで壊れる）。表示に使うのは
# 70 桁ぶんなので、正規化も幅の計算も先頭だけを見れば足りる。
#
# **`-R` で読む。** 走っているセッションの会話ログは追記の途中でありうる。
# 生の JSON として食わせると、最終行が半端なときに jq がそこで落ちて
# **その行より前も出せなくなる**。行単位で読んで `fromjson?` で落とせば、
# 半端な行だけが黙って消える。
#
# shellcheck disable=SC2016  # $w / $s は jq の変数
CCS_LS_REQUEST_JQ='
def wide:
  . >= 4352 and (
       . <= 4447
    or (. >= 11904 and . <= 42191)
    or (. >= 44032 and . <= 55203)
    or (. >= 63744 and . <= 64255)
    or (. >= 65072 and . <= 65135)
    or (. >= 65281 and . <= 65376)
    or (. >= 65504 and . <= 65510));
def clip($w):
  . as $s
  | [foreach (explode | map(if wide then 2 else 1 end))[] as $x (0; . + $x)] as $acc
  | if ($acc | length) == 0 or $acc[-1] <= $w then $s
    else ([range(0; $acc | length) | select($acc[.] <= $w - 1)] | length) as $i
      | $s[:$i] + "…"
    end;
[ inputs
| fromjson? // empty
| (if (.message.content | type) == "string" then .message.content
   else [.message.content[]? | select(.type == "text") | .text] | join(" ")
   end)
| select(type == "string")
| .[:400]
| gsub("\\s+"; " ")
| sub("^ "; "")
| sub(" $"; "")
| select(length > 0)
| select(startswith("<") | not)
| select(startswith("[Request interrupted") | not)
| select(startswith("[Image:") | not)
| select(startswith("Caveat:") | not)
| select(startswith("Base directory for this skill:") | not)
| select(startswith("This session is being continued") | not)
| select(startswith("Continue from where you left off") | not)
| select(startswith("Please continue") | not)
| clip($w)
] | last // empty
'

# 末尾から読み進める幅（バイト）。ここで当たらなければ全部読む。
#
# 実測（2026-08-27、立っていた 15 本）: 末尾から「最後の依頼」までの距離は
# 9 本が 100KB 以内、最大でも 1.6MB だった。**256KB → 4MB の 2 段**で
# 全部に届く。
CCS_LS_REQUEST_CHUNKS='262144 4194304'

# 標準入力（会話ログ、またはその末尾）から依頼を 1 行取り出す。
last_request_from_stream() {
	LC_ALL=C grep -aE "$CCS_LS_USER_RE" 2>/dev/null |
		tail -n "$CCS_LS_REQUEST_CANDIDATES" |
		"$CCS_JQ_BIN" -Rrn --argjson w "$CCS_LS_REQUEST_WIDTH" \
			"$CCS_LS_REQUEST_JQ" 2>/dev/null
}

# その会話ログで最後に人が頼んだこと。無ければ何も出さない。
#
# **末尾から広げていく。** 会話ログは 50MB を超えることがあり、全部を
# grep に通すと 1 本で 0.6 秒かかる（実測、下記）。かといって末尾だけを
# 決め打ちで読むと届かない ── 暫定のハブ用スクリプトは末尾 300KB 固定で、
# 13 本中 4 本が空欄になっていた。**当たるまで広げ、最後は全部読む**なら、
# 速い側を取りながら空欄も出ない。
#
# 実測（macOS 15 / BSD grep / 50MB の会話ログ / ページキャッシュ温）:
#
#   tail -c 256K | grep -E   0.01 秒
#   tail -c 4M   | grep -E   0.12 秒
#   grep -E（50MB 全体）      0.30 秒
#
# **`grep` の速さを測るときは、対話シェルの別名に注意すること。** ここは
# 一度取り違えた ── 手元の zsh では `grep` が ugrep に化けていて、同じ
# 50MB が 0.019 秒で終わる。`ccs` が起動するのは `/usr/bin/grep` なので、
# その数字で設計すると 30 倍外す。
#
# **チャンクの先頭は行の途中から始まる。** 半端な行はパターンに当たっても
# JSON として読めないので `fromjson?` が黙って落とす（`CCS_LS_REQUEST_JQ`）。
# 切れ目がちょうど最後の依頼の行を割ったときだけ 1 つ前の依頼が出るが、
# 2KB の行が 256KB の切れ目に当たる確率なので、そのために 1 段増やさない。
last_request_of() {
	_lr_file=$1
	[ -f "$_lr_file" ] || return 0

	_lr_size=$(wc -c <"$_lr_file" 2>/dev/null | tr -d ' ') || _lr_size=''
	[ -n "$_lr_size" ] || return 0

	for _lr_chunk in $CCS_LS_REQUEST_CHUNKS; do
		# チャンクがファイルより大きければ、末尾を読むことは全部読むことと
		# 同じ。**同じ範囲を 2 度読まない**ので、ここで打ち切って下へ落とす。
		[ "$_lr_chunk" -lt "$_lr_size" ] || break

		_lr_hit=$(tail -c "$_lr_chunk" "$_lr_file" 2>/dev/null | last_request_from_stream)
		if [ -n "$_lr_hit" ]; then
			printf '%s\n' "$_lr_hit"
			return 0
		fi
	done

	last_request_from_stream <"$_lr_file"
}

# そのファイルの mtime（epoch 秒）。取れなければ何も出さない。
#
# **`stat` を使わない。** BSD の `-f %m` と GNU の `-c %Y` で綴りが違う。
# `date -r <ファイル>` は両方にある（`restore_mtime_of` と同じ理由）。
mtime_epoch_of() {
	[ -f "$1" ] || return 0
	date -r "$1" '+%s' 2>/dev/null || return 0
}

# 「いま」の epoch 秒。**1 回の `ccs ls -l` で 1 度だけ取る** ── 行ごとに
# `date` を起こすと、それだけで無視できない（15 本で 15 プロセス）。
CCS_LS_NOW=''

# epoch 秒 → 経過時間の短い表記（`3m` / `2h` / `5d`）。
ls_age_text() {
	[ -n "$1" ] && [ "$1" != '-' ] || return 0
	[ -n "$CCS_LS_NOW" ] || CCS_LS_NOW=$(date '+%s')
	_ag_d=$((CCS_LS_NOW - $1))
	[ "$_ag_d" -ge 0 ] || _ag_d=0
	if [ "$_ag_d" -lt 3600 ]; then
		printf '%dm' "$((_ag_d / 60))"
	elif [ "$_ag_d" -lt 86400 ]; then
		printf '%dh' "$((_ag_d / 3600))"
	else
		printf '%dd' "$((_ag_d / 86400))"
	fi
}

# pid → RSS(KB) の対応表を **1 回の ps** で作る。
#
# セッションごとに `ps` を起こさない。13 本で 13 回のプロセス起動は、
# この列の存在理由（低コスト）をそのまま削る。
#
# 形は `|<pid>:<kb>|<pid>:<kb>|…` の 1 行。**引くのにプロセスを使わない**
# ようにするため（シェルの変数展開だけで取り出せる）。
ls_rss_table() {
	[ -n "$1" ] || return 0
	"$CCS_PS_BIN" -o pid=,rss= -p "$1" 2>/dev/null |
		awk 'NF >= 2 { printf "|%s:%s", $1, $2 } END { print "|" }'
}

# 対応表から <pid> の RSS を MB で引く。無ければ何も出さない。
ls_rss_of() {
	[ -n "$2" ] && [ "$2" != '-' ] || return 0
	case $1 in
	*"|${2}:"*) ;;
	*) return 0 ;;
	esac
	_rs=${1#*"|${2}:"}
	_rs=${_rs%%|*}
	[ -n "$_rs" ] || return 0
	printf '%d' "$(((_rs + 512) / 1024))"
}

# `collect_session_row` の行に盤面の列を足す。
#   slug<TAB>status<TAB>sessionId<TAB>path<TAB>pid<TAB>rssMb<TAB>mtime<TAB>request
ls_board_rows() {
	_brows=$1

	_bpids=$(printf '%s\n' "$_brows" |
		awk -F'\t' 'NF && $5 != "" && $5 != "-" { printf "%s%s", (n++ ? "," : ""), $5 }')
	_brss=$(ls_rss_table "$_bpids")

	# 会話ログの場所は cwd と sessionId から決まる（`transcript_path` と同じ
	# 規則）。**行ごとに `sed` を起こさない** ── あれは 1 行あたり 3 プロセス
	# になるので、15 本で 45 プロセスを払うことになる。ここは awk 1 回で足りる。
	#
	# **まだ 1 度もやり取りしていないセッションでは会話ログが無い**ので、
	# 読めないことを異常にしない（`transcript_path` の但し書きと同じ）。
	printf '%s\n' "$_brows" |
		awk -F'\t' -v dir="$CCS_PROJECTS_DIR" 'NF {
			enc = $4
			gsub(/[^A-Za-z0-9]/, "-", enc)
			printf "%s\t%s/%s/%s.jsonl\n", $0, dir, enc, $3
		}' |
		while IFS="$(printf '\t')" read -r _slug _status _id _path _pid _bfile; do
			[ -n "$_slug" ] || continue
			# **無い値は `-` で運ぶ**（空欄にしない。`collect_session_row` の
			# `_pid` と同じ理由 ── 空のタブ区切りの欄は read で潰れる）。
			_brss_mb=$(ls_rss_of "$_brss" "$_pid")
			_bmt=$(mtime_epoch_of "$_bfile")
			_breq=$(last_request_of "$_bfile")
			printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
				"$_slug" "$_status" "$_id" "$_path" "$_pid" \
				"${_brss_mb:--}" "${_bmt:--}" "$_breq"
		done
}

# 数値か、無ければ（空か `-`）null。
json_num() {
	if [ -n "$1" ] && [ "$1" != '-' ]; then
		printf '%s' "$1"
	else
		printf 'null'
	fi
}

# 盤面の JSON。**既定の `--json` のキーはそのまま残して足すだけ** ──
# 既に読んでいる側を壊さない。
ls_as_json_long() {
	_rows=$1
	printf '['
	_first=1
	printf '%s\n' "$_rows" | while IFS="$(printf '\t')" read -r _slug _status _id _path _pid _rss _mt _req; do
		[ -n "$_slug" ] || continue
		[ "$_first" = 1 ] || printf ','
		_first=0
		printf '{"slug":%s,"status":%s,"sessionId":%s,"path":%s,"tmux":%s,"pid":%s,"rssMb":%s,"updatedAt":%s,"age":%s,"request":%s}' \
			"$(json_str "$_slug")" "$(json_str "$_status")" \
			"$(json_str "$_id")" "$(json_str "$_path")" \
			"$(json_str "${CCS_PREFIX}${_slug}")" \
			"$(json_num "$_pid")" "$(json_num "$_rss")" \
			"$(json_num "$_mt")" "$(json_str "$(ls_age_text "$_mt")")" \
			"$(json_str "$_req")"
	done
	printf ']\n'
}

# 盤面の表。
#
# **SESSION ID と PATH は落とす。** 13 本を 1 画面に収めるのが目的なので、
# 36 桁の uuid と長いパスを並べると依頼が折り返して読めなくなる。
# uuid が要るときは既定の `ccs ls`、機械で読むなら `ccs ls -l --json`。
ls_as_table_long() {
	_rows=$1

	_w=$(printf '%s\n' "$_rows" |
		awk -F'\t' 'NF && length($1) > m { m = length($1) } END { print (m < 4 ? 4 : m) }')

	printf "%-${_w}s  %-8s  %6s  %5s  %s\n" 'SLUG' 'STATUS' 'RSS' 'AGE' 'REQUEST'
	printf '%s\n' "$_rows" | while IFS="$(printf '\t')" read -r _slug _status _id _path _pid _rss _mt _req; do
		[ -n "$_slug" ] || continue
		if [ -n "$_rss" ] && [ "$_rss" != '-' ]; then
			_rss="${_rss}M"
		else
			_rss='-'
		fi
		_age=$(ls_age_text "$_mt")
		[ -n "$_age" ] || _age='-'
		printf "%-${_w}s  %-8s  %6s  %5s  %s\n" \
			"$_slug" "$_status" "$_rss" "$_age" "$_req"
	done
}

cmd_ls() {
	require_deps

	_json=''
	_long=''
	while [ $# -gt 0 ]; do
		case $1 in
		--json) _json=1 ;;
		-l | --long) _long=1 ;;
		*) die "$EX_USAGE" "ls: 知らないオプション: $1" ;;
		esac
		shift
	done

	_slugs=$(list_slugs)

	if [ -z "$_slugs" ]; then
		if [ -n "$_json" ]; then
			printf '[]\n'
		else
			printf '立っているセッションはありません。\n'
			printf "\n  立てる: ccs new <target>\n"
		fi
		return 0
	fi

	_rows=''
	for _slug in $_slugs; do
		_rows="${_rows}$(collect_session_row "$_slug")
"
	done

	if [ -n "$_long" ]; then
		_rows=$(ls_board_rows "$_rows")
		if [ -n "$_json" ]; then
			ls_as_json_long "$_rows"
		else
			ls_as_table_long "$_rows"
		fi
	elif [ -n "$_json" ]; then
		ls_as_json "$_rows"
	else
		ls_as_table "$_rows"
	fi
}

# ---------------------------------------------------------------------------
# 乗り込む / 畳む
# ---------------------------------------------------------------------------

# いま自分がいる tmux セッション名。tmux の外なら空。
#
# **同じ tmux サーバにいるときだけ意味がある。** `$TMUX` は自分が繋がって
# いるサーバのソケットを指すので、ccs が管理しているサーバ（テストでは
# `-S` 付きの専用サーバ）と違えば、名前が偶然一致しても自分ではない。
# セッション名ではなくペイン ID で引くのも同じ理由 ── 名前は当てにならない。
current_tmux_session() {
	[ -n "${TMUX:-}" ] || return 0
	[ -n "${TMUX_PANE:-}" ] || return 0

	_my_socket=${TMUX%%,*}
	_managed_socket=$("$CCS_TMUX_BIN" display-message -p '#{socket_path}' 2>/dev/null || true)
	[ -n "$_managed_socket" ] || return 0
	[ "$_managed_socket" = "$_my_socket" ] || return 0

	"$CCS_TMUX_BIN" display-message -p -t "$TMUX_PANE" '#{session_name}' 2>/dev/null || true
}

# その slug が無いときに、候補を出して落とす。
# 「無い」とだけ言われても次の手が分からない。
die_no_such_slug() {
	_slug=$1
	warn "ccs: そのセッションはありません: ${CCS_PREFIX}${_slug}"
	warn ''

	_slugs=$(list_slugs)
	if [ -n "$_slugs" ]; then
		warn '立っているのは:'
		printf '%s\n' "$_slugs" | while IFS= read -r _s; do
			[ -n "$_s" ] || continue
			warn "  ${_s}"
		done
	else
		warn '立っているセッションはありません。'
		warn '  立てる: ccs new <target>'
	fi
	exit "$EX_FAIL"
}

# slug を省いたときに、番号で選ばせて `_slug` に入れる。
#
# **スマホから使うための入口。** ソフトキーボードで slug を打つのは高くつく
# （docs/mobile-terminal.md §10.5）。`ccs ls` を見て打ち直す往復も同じ。
#
# **これは `ccs ls` + `ccs attach` の言い換えであって、新しい概念ではない。**
# 出す情報は `ccs ls` と同じものを絞ったもので、決めるのは人。
#
# 対話が要るので、**端末が無ければ従来どおり使い方の誤りとして落とす。**
# スクリプトやハブが引数を渡し忘れたときに、黙って入力を待って固まるより、
# その場で 2 番で落ちるほうが原因に辿り着ける。
attach_pick_slug() {
	[ -t 0 ] || die "$EX_USAGE" 'attach: <slug> を指定してください'

	_pick_slugs=$(list_slugs)
	if [ -z "$_pick_slugs" ]; then
		warn '立っているセッションはありません。'
		warn ''
		warn '  立てる: ccs new <target>'
		exit "$EX_FAIL"
	fi

	_pick_rows=''
	for _pick_one in $_pick_slugs; do
		_pick_rows="${_pick_rows}$(collect_session_row "$_pick_one")
"
	done
	_pick_rows=$(printf '%s\n' "$_pick_rows" | awk -F'\t' 'NF')
	_pick_max=$(printf '%s\n' "$_pick_rows" | wc -l | tr -d ' ')

	# slug の最大幅に合わせる（`ls_as_table` と同じ理由。固定幅だと崩れる）。
	_pick_w=$(printf '%s\n' "$_pick_rows" |
		awk -F'\t' 'length($1) > m { m = length($1) } END { print (m < 4 ? 4 : m) }')

	# **一覧もプロンプトも stderr に出す。** 選んだあとは exec で tmux に
	# 置き換わるので stdout は tmux のものになる。混ぜない。
	printf '%s\n' "$_pick_rows" |
		awk -F'\t' -v w="$_pick_w" '{ printf "%3d) %-*s  %s\n", NR, w, $1, $2 }' >&2

	printf '\n番号を選ぶ（Enter で中止）: ' >&2
	read -r _pick_n || exit "$EX_OK"
	[ -n "$_pick_n" ] || exit "$EX_OK"

	case $_pick_n in
	*[!0-9]*) die "$EX_USAGE" "attach: 番号ではありません: ${_pick_n}" ;;
	esac
	[ "$_pick_n" -ge 1 ] && [ "$_pick_n" -le "$_pick_max" ] ||
		die "$EX_USAGE" "attach: 1〜${_pick_max} の番号を選んでください: ${_pick_n}"

	_slug=$(printf '%s\n' "$_pick_rows" | sed -n "${_pick_n}p" | cut -f1)
}

cmd_attach() {
	require_deps

	if [ $# -ge 1 ]; then
		_slug=$1
	else
		attach_pick_slug
	fi
	_session="${CCS_PREFIX}${_slug}"

	tmux_session_exists "$_session" || die_no_such_slug "$_slug"

	# **すでに tmux の中にいるなら attach ではなく switch-client。**
	# 入れ子の attach は tmux が拒む（"sessions should be nested with care"）。
	# ハブが tmux の中で動いていることは十分ありうる。
	if [ -n "${TMUX:-}" ]; then
		exec "$CCS_TMUX_BIN" switch-client -t "$_session"
	else
		exec "$CCS_TMUX_BIN" attach-session -t "$_session"
	fi
}

cmd_kill() {
	require_deps

	_force=''
	_slug=''
	while [ $# -gt 0 ]; do
		case $1 in
		-f | --force) _force=1 ;;
		-*) die "$EX_USAGE" "kill: 知らないオプション: $1" ;;
		*)
			[ -z "$_slug" ] || die "$EX_USAGE" "kill: <slug> は 1 つだけです: ${_slug} と $1"
			_slug=$1
			;;
		esac
		shift
	done

	[ -n "$_slug" ] || die "$EX_USAGE" 'kill: <slug> を指定してください'

	_session="${CCS_PREFIX}${_slug}"

	# **hub は kill では畳まない（--force でも）。**
	# hub を落とすと、スマホから ccs を叩く経路そのものが消える。
	# 止めたいなら意図を持って `ccs hub down`、直したいなら `ccs hub restart`。
	if [ "$_slug" = "$CCS_HUB_SLUG" ]; then
		warn "ccs: ${_slug} は hub です。kill では畳みません。"
		warn ''
		warn '  立て直す:       ccs hub restart'
		warn '  意図的に止める: ccs hub down'
		exit "$EX_FAIL"
	fi

	tmux_session_exists "$_session" || die_no_such_slug "$_slug"

	# **いま自分が動いているセッションは、うっかりでは畳ませない。**
	# ハブのエージェントが自分自身を指したとき、会話ごと消えて
	# 「なぜ落ちたか」を聞く相手もいなくなる。
	if [ -z "$_force" ] && [ "$_session" = "$(current_tmux_session)" ]; then
		warn "ccs: ${_slug} は、いまあなた自身が動いているセッションです。"
		warn ''
		warn '  それでも畳む: ccs kill --force '"${_slug}"
		exit "$EX_FAIL"
	fi

	# **畳む前に集める。** 畳んだあとでは tmux からもレジストリからも
	# 何も引けなくなり、復帰の手掛かりを出せない。
	_id=$(live_session_id_for "$_slug" || true)
	[ -n "$_id" ] || _id=$(pane_session_id_for "$_session")
	_cwd=$(pane_or_registry_cwd "$_slug")

	# 作業中のセッションは黙って落とさない。
	#
	# ハブのエージェントが打ち間違えて実行することを想定すると、
	# 走っている作業を巻き込むのは取り返しがつきにくい。会話自体は
	# transcript に残るので --resume で戻せるが、走っていたコマンドの
	# 途中経過は戻らない。
	if [ -z "$_force" ]; then
		# `|| true` が要る。set -e の下では `var=$(失敗する関数)` で
		# その場で終了する。claude が既に終了しているとレジストリに
		# 項目が無く、status を引けないのが正常な経路。
		_status=$(session_status_for "$_slug" || true)
		if [ "$_status" = 'working' ]; then
			warn "ccs: ${_slug} は作業中です。畳みませんでした。"
			warn ''
			warn '  様子を見る:   ccs attach '"${_slug}"
			warn '  それでも畳む: ccs kill --force '"${_slug}"
			exit "$EX_FAIL"
		fi
	fi

	"$CCS_TMUX_BIN" kill-session -t "$_session" ||
		die "$EX_FAIL" "畳めませんでした: ${_session}"

	printf '%s を畳みました。\n' "$_session"

	# **uuid を必ず添える。** v1 に resume が無いので、あとで同じ会話に
	# 戻りたくなったときの手掛かりはこれしかない。
	if [ -n "$_id" ]; then
		printf '\n同じ会話に戻るには:\n  cd %s && claude --resume %s\n' \
			"$(tilde_path "$_cwd")" "$_id"
	fi

	# **kill は worktree を消さない**（ADR-0003 決定 7、design.md §9.6）。
	# そこに未コミットの作業が残っていることがあり、消す判断は人がする。
	# 片付け先だけ 1 行案内する ── 畳んだ時点でこのパスを引ける最後の機会で、
	# あとから探すには git の一覧を舐めることになる。
	if [ -n "$_cwd" ] && path_is_linked_worktree "$_cwd"; then
		printf '\nworktree は残しています: %s\n  片付ける: ccs gc\n' \
			"$(tilde_path "$_cwd")"
	fi
}

# status を引く。取れなければ空。
session_status_for() {
	_f=$(registry_file_for_slug "$1") || return 1
	registry_field "$_f" status
}

# cwd を引く。レジストリに無ければペインから。
pane_or_registry_cwd() {
	_slug=$1
	if _c=$(live_cwd_for "$_slug") && [ -n "$_c" ]; then
		printf '%s' "$_c"
		return 0
	fi
	"$CCS_TMUX_BIN" list-panes -t "${CCS_PREFIX}${_slug}" -F '#{pane_current_path}' 2>/dev/null | head -1
}

# ---------------------------------------------------------------------------
# 掃除
#
# **既定は dry-run。** 消す操作は必ず一度見せてから実行する
# （`ghq rm --dry-run` と同じ作法）。ハブのエージェントが打つことを
# 想定すると、確認なしで消える設計は割に合わない。
#
# 扱うのは 2 系統:
#
# **作業枠（`~/.cc-scratch/<n>`）**
#
#   1. claude が終了した cc/ セッション  … 畳む（uuid を控えてから）
#   2. 空のまま残った作業枠のディレクトリ … 消す（次に使うとき作り直される）
#   3. 中身が残っている作業枠            … **報告だけ。絶対に消さない**
#
# 3 を消さないのは、そこにあるのが利用者のファイルだから。枠を塞いでいるのは
# 事実だが、それは人が見て判断すること。
#
# **worktree（`<repo>/.worktrees/<branch-slug>`）**（W3、ADR-0003 決定 7）
#
#   A 消す候補         … clean + merge 済み + push 済み
#   B 未 merge / 未 push … **報告だけ**
#   C dirty            … **報告だけ**（追跡外ファイルを含む）
#   D prunable         … ディレクトリだけ消えている。`git worktree prune`
#
# **`git worktree remove` と `git branch -d` を素で使うことが安全性の本体。**
# 実測（2026-08-26）:
#
#   - `worktree remove` は追跡外ファイルだけでも拒む
#   - clean なら未 merge のコミットがあっても消す。**ただしブランチ ref は
#     残るのでコミットは失われない**
#   - `branch -d` は未 merge を拒む。**コミットを守るのはこの層**
#   - ブランチが worktree で開かれている間は `branch -d` が拒む。だから
#     `remove` → `branch -d` の順序は必然
#
# この 2 つを force 無しで直列に通す限り、「未 push かつ未マージ」は自動では
# 消えない。**`--force` / `-D` に切り替えるところが人に聞く境界になる**
# （グローバル AGENTS.md）。ccs はその境界を越えない。
# ---------------------------------------------------------------------------

# tmux セッションが立っていない作業枠を、空かどうかで分けて出す。
#   <empty|used><TAB><path>
orphan_slots() {
	[ -d "$CCS_SCRATCH_ROOT" ] || return 0

	_i=1
	while [ "$_i" -le "$CCS_SCRATCH_SLOTS" ]; do
		_slot="${CCS_SCRATCH_ROOT}/${_i}"
		if [ -d "$_slot" ] && ! tmux_session_exists "${CCS_PREFIX}tmp-${_i}"; then
			if dir_is_empty "$_slot"; then
				printf 'empty\t%s\n' "$_slot"
			else
				printf 'used\t%s\n' "$_slot"
			fi
		fi
		_i=$((_i + 1))
	done
}

# 生きている claude の cwd を 1 行 1 つ出す。
#
# **レジストリを直接舐める。slug を経由しない**（ADR-0002 決定 1・3）。
# `live_cwd_for <slug>` は `"tmux":"cc/<slug>:"` で引き当てる形なので、
# **Remote Control で改名されたセッションが「居ない」ことになる**
# （バックログ I1 の穴。実測でこの経路を踏んだ）。作業枠なら次に使うとき
# 作り直されるだけだが、**worktree は人のブランチごと消えかねない**ので、
# ここだけは先に名前への依存を切る。
#
# **ccs 以外の claude も数える。** レジストリにはデスクトップアプリや
# VS Code のセッションも並ぶ。誰が立てたものであれ、そこで生きているなら
# その作業ツリーは掃除の対象ではない。
gc_live_cwds() {
	for _f in "$CCS_SESSIONS_DIR"/*.json; do
		[ -e "$_f" ] || continue
		registry_is_live "$_f" || continue
		_c=$(registry_field "$_f" cwd) || _c=''
		[ -n "$_c" ] || continue
		abs_dir "$_c" 2>/dev/null || printf '%s\n' "$_c"
	done
}

# そのパス（かその下）に、生きているセッションが居るか。
#
# 前方一致で見る。ペインの cwd は worktree の中のサブディレクトリに
# 降りていることがある。
gc_path_in_use() {
	printf '%s\n' "$2" | (
		while IFS= read -r _u; do
			[ -n "$_u" ] || continue
			case $_u in
			"$1" | "$1"/*) exit 0 ;;
			esac
		done
		exit 1
	)
}

# そのブランチが本体の HEAD に merge 済みか。
#
# **`git branch -d` より意図的に厳しい。** あちらは「HEAD に merge 済み
# **または上流に merge 済み**」で通す（実測、2026-08-26: push 済みのブランチは
# main に未 merge でも警告付きで消える）。つまり `branch -d` にとっては、
# ここで別に測っている「push 済み」だけで十分ということになる。
#
# **それでも main に入ったことまで求める。** push 済みはコミットが remote に
# 残っていることしか意味せず、作業が終わったことを意味しない。掃除の対象は
# 「終わったもの」であって「保存されているもの」ではない。
#
# **厳しい側に倒れていることが大事。** 予告が実行より緩いと、消す候補に
# 出したものが実行時に拒まれる。逆（予告のほうが厳しい）は、消せるものを
# 消さずに報告するだけなので害が無い。
gc_branch_is_merged() {
	_m=$("$CCS_GIT_BIN" -C "$1" branch --merged HEAD --list "$2" \
		--format='%(refname:short)' 2>/dev/null) || return 1
	[ -n "$_m" ]
}

# ccs が作った worktree を列挙して分類する。
#   <kind><TAB><repo><TAB><path><TAB><branch><TAB><note>
#
# kind は removable / keep / dirty / prunable。稼働中のものは出さない
# （既存の gc が「生きているセッションだけなら何もしない」のと同じ扱い）。
#
# **ディレクトリを走査しない。git に一覧を訊く**（ADR-0003 決定 3）。
# `prunable` はディレクトリごと消えている状態なので、glob では原理的に
# 拾えない ── `git worktree list --porcelain` だけが知っている。
#
# **`<repo>/.worktrees/` 配下だけを対象にする。** 人が手で切った worktree は
# ccs の場所ではない。
#
# **安い門番として `.git/worktrees` の有無を先に見る。** これは git 自身の
# 台帳で、登録が 1 件も無ければ存在しない。`ghq list` は数百件になりうるので、
# 大多数を git を起こさずに落とせることが効く。
gc_worktrees() {
	have "$CCS_GIT_BIN" || return 0
	have "$CCS_GHQ_BIN" || return 0

	_live=$1

	"$CCS_GHQ_BIN" list -p 2>/dev/null | while IFS= read -r _repo; do
		[ -n "$_repo" ] || continue
		_rp=$(abs_dir "$_repo" 2>/dev/null) || continue
		[ -d "${_rp}/.git/worktrees" ] || continue
		_wt_dir="${_rp}/${CCS_WORKTREE_DIR}"

		"$CCS_GIT_BIN" -C "$_rp" worktree list --porcelain 2>/dev/null | awk '
			function flush() {
				if (p != "") printf "%s\t%s\t%s\t%s\n", p, b, pr, lk
				p = ""; b = ""; pr = 0; lk = 0
			}
			/^worktree /  { flush(); p = substr($0, 10); next }
			/^branch /    { b = substr($0, 8); sub(/^refs\/heads\//, "", b); next }
			/^prunable/   { pr = 1; next }
			/^locked/     { lk = 1; next }
			END { flush() }
		' | while IFS="$(printf '\t')" read -r _p _br _prunable _locked; do
			[ -n "$_p" ] || continue
			# 本体と、ccs の場所の外にあるものを落とす。
			case $_p in
			"$_wt_dir"/*) ;;
			*) continue ;;
			esac

			# D. ディレクトリだけ消えている。ほかは測りようが無いので先に見る。
			if [ "$_prunable" = 1 ]; then
				printf 'prunable\t%s\t%s\t%s\t%s\n' \
					"$_rp" "$_p" "${_br:--}" 'ディレクトリが無い'
				continue
			fi

			[ -d "$_p" ] || continue

			# 稼働中は掃除の対象ではない。**報告もしない。**
			if gc_path_in_use "$_p" "$_live"; then
				continue
			fi

			# 分離 HEAD は枝を名乗れないので、素性として扱わない
			# （`path_is_linked_worktree` と同じ判断）。消さずに報告する。
			if [ -z "$_br" ]; then
				printf 'keep\t%s\t%s\t%s\t%s\n' "$_rp" "$_p" '-' '分離 HEAD'
				continue
			fi

			# lock されているものは `worktree remove` が拒む。
			if [ "$_locked" = 1 ]; then
				printf 'keep\t%s\t%s\t%s\t%s\n' "$_rp" "$_p" "$_br" 'locked'
				continue
			fi

			# C. dirty。**merge 判定より先に見る** ── そもそも
			# `worktree remove` が拒むので、merge 済みかどうかは関係が無い。
			# 追跡外ファイルも dirty に数える（`status --porcelain` の既定）。
			_st=$("$CCS_GIT_BIN" -C "$_p" status --porcelain 2>/dev/null) || _st=''
			if [ -n "$_st" ]; then
				_n=$(printf '%s\n' "$_st" | grep -c '^' | tr -d ' ')
				printf 'dirty\t%s\t%s\t%s\t%s\n' \
					"$_rp" "$_p" "$_br" "変更 ${_n}"
				continue
			fi

			# push 済みか。**上流が無ければ「未 push」に倒す**
			# （ADR-0003 決定 7）。git は上流が無いと fatal で落ちるので、
			# 空文字と 0 を区別する必要がある。
			_ahead=''
			if _out=$("$CCS_GIT_BIN" -C "$_p" rev-list --count '@{u}..HEAD' 2>/dev/null); then
				_ahead=$_out
			fi

			_merged=''
			gc_branch_is_merged "$_rp" "$_br" && _merged=1

			# A. clean + merge 済み + push 済み。
			if [ -n "$_merged" ] && [ "$_ahead" = 0 ]; then
				printf 'removable\t%s\t%s\t%s\t%s\n' \
					"$_rp" "$_p" "$_br" 'merge 済み・push 済み'
				continue
			fi

			# B. それ以外は報告だけ。
			if [ -z "$_ahead" ]; then
				_note='上流なし'
			elif [ "$_ahead" != 0 ]; then
				_note="未 push ${_ahead}"
			else
				_note=''
			fi
			if [ -z "$_merged" ]; then
				if [ -n "$_note" ]; then
					_note="未 merge・${_note}"
				else
					_note='未 merge'
				fi
			fi
			printf 'keep\t%s\t%s\t%s\t%s\n' "$_rp" "$_p" "$_br" "$_note"
		done
	done
}

cmd_gc() {
	require_deps

	_apply=''
	while [ $# -gt 0 ]; do
		case $1 in
		-y | --yes) _apply=1 ;;
		*) die "$EX_USAGE" "gc: 知らないオプション: $1" ;;
		esac
		shift
	done

	# 1. 止まっているセッション
	#
	# **hub は対象外。** 止まっていても畳まない ── 畳むと
	# `pane_start_command` ごと消えて復帰の手掛かりが減るうえ、
	# hub は `ccs hub up`（自動起動）が立て直すので gc の仕事ではない。
	_stopped=''
	_hub_stopped=''
	for _slug in $(list_slugs); do
		if live_session_id_for "$_slug" >/dev/null 2>&1; then
			continue
		fi
		if [ "$_slug" = "$CCS_HUB_SLUG" ]; then
			_hub_stopped=1
			continue
		fi
		_uuid=$(pane_session_id_for "${CCS_PREFIX}${_slug}")
		[ -n "$_uuid" ] || _uuid='-'
		_stopped="${_stopped}${_slug}	${_uuid}
"
	done

	# 2, 3. 使われていない作業枠
	_slots=$(orphan_slots)
	_empty_slots=$(printf '%s\n' "$_slots" | sed -n 's/^empty\t//p')
	_used_slots=$(printf '%s\n' "$_slots" | sed -n 's/^used\t//p')

	# A〜D. worktree
	#
	# **ループの中で変数を溜めるとサブシェルの外に出てこない**ので、
	# 一覧をまとめて受け取ってから分ける（`restore` と同じ形）。
	_wts=$(gc_worktrees "$(gc_live_cwds)")
	_wt_removable=$(printf '%s\n' "$_wts" | sed -n 's/^removable\t//p')
	_wt_keep=$(printf '%s\n' "$_wts" | sed -n 's/^keep\t//p')
	_wt_dirty=$(printf '%s\n' "$_wts" | sed -n 's/^dirty\t//p')
	_wt_prunable=$(printf '%s\n' "$_wts" | sed -n 's/^prunable\t//p')

	_found=''
	[ -n "$_stopped" ] && _found=1
	[ -n "$_empty_slots" ] && _found=1
	[ -n "$_wt_removable" ] && _found=1
	[ -n "$_wt_prunable" ] && _found=1

	_reported=''
	[ -n "$_used_slots" ] && _reported=1
	[ -n "$_wt_keep" ] && _reported=1
	[ -n "$_wt_dirty" ] && _reported=1

	# --- 報告 ---

	if [ -n "$_hub_stopped" ]; then
		printf 'hub が止まっています（gc の対象外）:\n'
		printf '  %-20s ccs hub up\n\n' "$CCS_HUB_SLUG"
	fi

	if [ -n "$_stopped" ]; then
		printf '止まっているセッション（畳む対象）:\n'
		printf '%s' "$_stopped" | while IFS="$(printf '\t')" read -r _s _u; do
			[ -n "$_s" ] || continue
			printf '  %-20s claude --resume %s\n' "$_s" "$_u"
		done
		# **畳むだけが選択肢ではない。** 同じ会話で立て直せる。
		printf '  （畳まずに同じ会話で立て直す: ccs restore）\n\n'
	fi

	if [ -n "$_empty_slots" ]; then
		printf '空のまま残った作業枠（消す対象）:\n'
		printf '%s\n' "$_empty_slots" | while IFS= read -r _p; do
			[ -n "$_p" ] || continue
			printf '  %s\n' "$(tilde_path "$_p")"
		done
		printf '\n'
	fi

	if [ -n "$_wt_removable" ]; then
		printf '不要になった worktree（消す対象）:\n'
		gc_print_worktrees "$_wt_removable"
		printf '\n'
	fi

	if [ -n "$_wt_prunable" ]; then
		printf 'ディレクトリだけ消えた worktree（登録を整理する対象）:\n'
		gc_print_worktrees "$_wt_prunable"
		printf '\n'
	fi

	# **中身のある枠は消さない。** 枠を塞いでいるのは事実だが、
	# そこにあるのは利用者のファイル。見て判断するのは人。
	if [ -n "$_used_slots" ]; then
		printf '中身が残っている作業枠（ccs は消しません。中を見て判断してください）:\n'
		printf '%s\n' "$_used_slots" | while IFS= read -r _p; do
			[ -n "$_p" ] || continue
			printf '  %s\n' "$(tilde_path "$_p")"
		done
		printf '\n'
	fi

	# **未 merge / 未 push と dirty は報告だけ。** ここを消すには
	# `--force` / `-D` が要り、そこが人に聞く境界（ADR-0003 決定 7）。
	if [ -n "$_wt_keep" ]; then
		printf '未 merge / 未 push の worktree（ccs は消しません）:\n'
		gc_print_worktrees "$_wt_keep"
		printf '\n'
	fi

	if [ -n "$_wt_dirty" ]; then
		printf '変更が残っている worktree（ccs は消しません。中を見て判断してください）:\n'
		gc_print_worktrees "$_wt_dirty"
		printf '\n'
	fi

	if [ -z "$_found" ]; then
		if [ -z "$_reported" ]; then
			printf '掃除するものはありません。\n'
		fi
		return 0
	fi

	if [ -z "$_apply" ]; then
		printf '実行するには: ccs gc --yes\n'
		return 0
	fi

	# --- 実行 ---
	#
	# **順序に意味がある。** 止まったセッションを先に畳むので、その
	# ペインが worktree に居たまま worktree を消すことにならない。

	printf '%s' "$_stopped" | while IFS="$(printf '\t')" read -r _s _u; do
		[ -n "$_s" ] || continue
		if "$CCS_TMUX_BIN" kill-session -t "${CCS_PREFIX}${_s}" 2>/dev/null; then
			printf '畳みました: %s%s\n' "$CCS_PREFIX" "$_s"
		else
			warn "ccs: 畳めませんでした: ${CCS_PREFIX}${_s}"
		fi
	done

	printf '%s\n' "$_empty_slots" | while IFS= read -r _p; do
		[ -n "$_p" ] || continue
		# rmdir を使う。中身があれば失敗して止まる ── rm -rf だと
		# 「空だと思ったら空ではなかった」ときに黙って消してしまう。
		if rmdir "$_p" 2>/dev/null; then
			printf '消しました: %s\n' "$(tilde_path "$_p")"
		else
			warn "ccs: 消せませんでした（空ではない可能性）: ${_p}"
		fi
	done

	# **`remove` → `branch -d` を素で直列に通す。** force に切り替えない。
	# どちらかが拒んだら、それは消してはいけないということ。
	printf '%s\n' "$_wt_removable" | while IFS="$(printf '\t')" read -r _rp _p _br _note; do
		[ -n "$_p" ] || continue
		if "$CCS_GIT_BIN" -C "$_rp" worktree remove "$_p" >/dev/null 2>&1; then
			printf '消しました: %s\n' "$(tilde_path "$_p")"
		else
			warn "ccs: worktree を消せませんでした: $(tilde_path "$_p")"
			warn "  ${CCS_GIT_BIN} -C $(shq "$_rp") worktree remove $(shq "$_p")"
			continue
		fi
		if "$CCS_GIT_BIN" -C "$_rp" branch -d "$_br" >/dev/null 2>&1; then
			printf '消しました: ブランチ %s\n' "$_br"
		else
			# **ここで -D に切り替えない。** git が拒んだということは
			# 消してはいけない理由があるということ。理由を断定せず、
			# 人が自分で見られる形にして渡す。
			warn "ccs: ブランチは残しました: ${_br}"
			warn "  理由を見る: ${CCS_GIT_BIN} -C $(shq "$_rp") branch -d $(shq "$_br")"
			warn "  中身を見る: ${CCS_GIT_BIN} -C $(shq "$_rp") log --oneline HEAD..$(shq "$_br")"
		fi
		# 空になったら `.worktrees/` 自体も畳む。rmdir なので、
		# ほかの worktree が残っていれば失敗して何もしない。
		rmdir "${_rp}/${CCS_WORKTREE_DIR}" 2>/dev/null || true
	done

	# **prune はリポジトリ単位。** `git worktree prune` に範囲を絞る手段は
	# 無いので、報告は `.worktrees/` 配下だけでも、実行はそのリポジトリの
	# 登録すべてに及ぶ。**それでも安全なのは、prune が落とすのが
	# 「ディレクトリが既に消えている登録」だけ**だから ── 生きている
	# worktree にもコミットにも触らない（git 自身の gc も同じことをする）。
	# 同じリポジトリで 2 度打たない。
	printf '%s\n' "$_wt_prunable" | awk -F'\t' 'NF > 1 && !seen[$1]++ { print $1 }' |
		while IFS= read -r _rp; do
			[ -n "$_rp" ] || continue
			if "$CCS_GIT_BIN" -C "$_rp" worktree prune >/dev/null 2>&1; then
				printf '登録を整理しました: %s\n' "$(tilde_path "$_rp")"
			else
				warn "ccs: 登録を整理できませんでした: $(tilde_path "$_rp")"
			fi
			rmdir "${_rp}/${CCS_WORKTREE_DIR}" 2>/dev/null || true
		done
}

# worktree の一覧を人が読む形で出す。入力は kind を落とした行。
gc_print_worktrees() {
	printf '%s\n' "$1" | while IFS="$(printf '\t')" read -r _rp _p _br _note; do
		[ -n "$_p" ] || continue
		if [ -n "$_note" ]; then
			printf '  %-24s %s（%s）\n' "$_br" "$(tilde_path "$_p")" "$_note"
		else
			printf '  %-24s %s\n' "$_br" "$(tilde_path "$_p")"
		fi
	done
}

# ---------------------------------------------------------------------------
# 立て直す
#
# **落ちたのはセッションであって、会話ではない。** 会話は
# `<CCS_PROJECTS_DIR>/<エンコードした cwd>/<uuid>.jsonl` に残るので、同じ場所で
# `claude --resume <uuid>` を立てれば同じ会話が戻る（実測。PC の再起動で消えた
# 8 本を手で戻せたのがこの機能の出発点）。
#
# ccs は状態ファイルを持たず tmux から導出する（design.md §2.1）。**だから
# 「さっきまで何が立っていたか」を誰も覚えていない。** 覚える代わりに、ccs 自身が
# 場所を決めているところだけを舐めて、そこに会話ログがあるかを見る:
#
#   1. 止まったペイン   … `cc/` の tmux セッションは残っているが claude が死んでいる
#   2. 消えた作業枠     … `CCS_SCRATCH_ROOT/<n>` に会話ログがある
#   3. 消えた worktree  … ghq 配下の `<repo>/.worktrees/<branch>` に会話ログがある
#   4. 消えたリポジトリ … ghq 配下で、**ccs が立てた印のある**会話ログがある
#
# **4 だけ条件が 1 つ多い。** ghq 配下の会話ログは ccs が立てたものとは限らず
# （デスクトップアプリや VS Code から開いたものも同じ場所に溜まる）、素朴に
# 拾うと ccs が管理していない会話まで tmux に生える。印の判定は
# `restore_started_by_ccs`。**ghq の外に立てたセッションは列挙できない**ので、
# それは名指しで戻す（`ccs restore <path>`）。
#
# **既定は dry-run**（`ccs gc` と同じ作法）。戻した会話は、続きがあればその場で
# 動き出す ── 確認なしで N 本が動き出す設計は割に合わない。
# ---------------------------------------------------------------------------

# `--session-id` で名指しされた会話。空なら自動で選ぶ。
CCS_RESTORE_SESSION_ID=''

# その会話ログの表示名。取れなければ 1 を返す。
#
# **最後に付いた名前が現在の名前。** 途中で改名すると新しい行が追記され、
# 古い行はそのまま残る（実測。1 行目は `tmp-2` のままで、末尾に人が付けた
# 名前が並ぶ）。全体を舐めないのは、会話ログが数 MB になるため。
restore_title_of() {
	_t=$(tail -c 262144 "$1" 2>/dev/null |
		grep -a -o '"customTitle":"[^"]*"' | tail -1) || _t=''
	if [ -z "$_t" ]; then
		_t=$(head -c 262144 "$1" 2>/dev/null |
			grep -a -o '"customTitle":"[^"]*"' | head -1) || _t=''
	fi
	[ -n "$_t" ] || return 1
	printf '%s' "$_t" | sed -e 's/^"customTitle":"//' -e 's/"$//'
}

# その会話がどこで動いていたか。会話ログに記録された cwd を読む。
#
# **エンコード規則を逆算しない。** `/` も `.` も `_` も同じ `-` に潰れるので、
# ディレクトリ名から元のパスは復元できない（`-cc-hub` が `.cc-hub` なのか
# `cc-hub` なのかは決められない）。ccs は規則を前向きにだけ使い
# （`transcript_dir_for`）、当たった会話ログの中の cwd で答え合わせをする。
# **規則が変わったらここで食い違うので、黙って別の会話を戻す代わりに飛ばせる。**
restore_cwd_of() {
	grep -a -m1 -o '"cwd":"[^"]*"' "$1" 2>/dev/null |
		sed -e 's/^"cwd":"//' -e 's/"$//'
}

# その置き場で最後に書かれた会話の uuid。無ければ 1 を返す。
#
# **どれを戻すかは「最後に触った会話」で決める。** 同じ場所で会話を何度も
# 立てていれば候補は複数あるが、落ちる直前に動いていたのは最後の 1 つ。
# 古いものを戻したいときは `--list` で uuid を見て `--session-id` で名指しする。
restore_latest_in() {
	[ -d "$1" ] || return 1
	# shellcheck disable=SC2012  # ファイル名は <uuid>.jsonl 固定なので ls で安全
	_f=$(ls -t "$1"/*.jsonl 2>/dev/null | head -1)
	[ -n "$_f" ] || return 1
	basename "$_f" .jsonl
}

# その会話を ccs が立てたか。
#
# **`ccs new` は `-n <slug>` を渡す**ので、本物は会話ログの **1 行目**に
# `custom-title` を書く（実測。`{"type":"custom-title","customTitle":"<slug>",…}`）。
# デスクトップアプリや VS Code から開いたセッションは名前が会話の内容から
# 自動で決まるため、この行が先頭に来ない（あとから付くことはある）。
#
# **これが無いと ghq 配下を列挙できない。** あそこの会話ログは ccs が立てた
# ものとは限らず、一括で戻すと ccs が管理していない会話まで tmux に生える。
#
# 実測（2026-08-23、会話ログ 247 本）: 立っている ccs セッション 12/12 に印が
# あり、デスクトップから開いたセッションには無かった。**アプリ側の実装に
# 依存した判定なので、外れたら「候補に出ない」side に倒れる** ── 黙って
# 知らない会話を立てるのではなく、名指しを求める形で失敗する。
restore_started_by_ccs() {
	head -c 8192 "$1" 2>/dev/null | head -1 | grep -q 'custom-title'
}

# 直近 CCS_RESTORE_MAX_AGE 日に触られた会話ログか。0 なら無制限。
#
# **`date` で差を取らない。** mtime を epoch で読む方法は環境差が大きい
# （BSD の `stat -f` と GNU の `stat -c`）。`find -mtime` は POSIX。
restore_is_fresh() {
	[ "$CCS_RESTORE_MAX_AGE" -gt 0 ] 2>/dev/null || return 0
	_hit=$(find "$1" -mtime "-${CCS_RESTORE_MAX_AGE}" 2>/dev/null | head -1)
	[ -n "$_hit" ]
}

# 実在しないかもしれない `<root>/<leaf>` を、実在する root を通して正規化する。
#
# **消えた枠のパスもエンコードの入力になる。** `/tmp` が `/private/tmp` に化ける
# 環境では、正規化を飛ばすと会話ログの置き場所を取り違える（design.md §6 で
# 一度踏んでいる）。
restore_abs_under() {
	_abs=$(abs_dir "$1" 2>/dev/null) || _abs=$1
	printf '%s/%s' "$_abs" "$2"
}

# 立て直す候補を列挙する。<slug><TAB><path><TAB><uuid>
#
# **hub は入れない。** 落ちても `ccs hub up`（自動起動）が立て直す担当で、
# 同じ会話に戻す手段も別にある（`ccs hub restart --resume`）。
restore_candidates() {
	# 1. ペインは残っているが claude が死んでいるもの。
	#
	# **ここは会話ログを探さなくてよい。** ペインの起動コマンドに uuid が
	# 残っているので、そのペインが何の会話だったかを直接引ける。古さも見ない
	# ── tmux セッションが在ること自体が「さっきまで居た」証拠。
	for _slug in $(list_slugs); do
		[ "$_slug" = "$CCS_HUB_SLUG" ] && continue
		live_session_id_for "$_slug" >/dev/null 2>&1 && continue

		_p=$(pane_or_registry_cwd "$_slug" 2>/dev/null) || _p=''
		[ -n "$_p" ] || continue
		_u=$(pane_session_id_for "${CCS_PREFIX}${_slug}")
		[ -n "$_u" ] || _u=$(restore_latest_in "$(transcript_dir_for "$_p")") || _u=''
		[ -n "$_u" ] || continue

		printf '%s\t%s\t%s\n' "$_slug" "$_p" "$_u"
	done

	# 2. tmux セッションごと消えた作業枠。
	#
	# **ディレクトリが空でも候補にする。** 枠に何も書かない会話は珍しくない
	# （外の道具だけを触るセッション）。空かどうかは会話が残っているかと関係が
	# 無いので、見るのは会話ログのほう。
	_i=1
	while [ "$_i" -le "$CCS_SCRATCH_SLOTS" ]; do
		_slug="tmp-${_i}"
		if ! tmux_session_exists "${CCS_PREFIX}${_slug}"; then
			_p=$(restore_abs_under "$CCS_SCRATCH_ROOT" "$_i")
			if _u=$(restore_latest_in "$(transcript_dir_for "$_p")"); then
				if restore_is_fresh "$(transcript_path "$_p" "$_u")"; then
					printf '%s\t%s\t%s\n' "$_slug" "$_p" "$_u"
				fi
			fi
		fi
		_i=$((_i + 1))
	done

	# 3. tmux セッションごと消えた worktree セッション。
	#
	# **ディレクトリを走査しない。git に一覧を訊く**（ADR-0003 決定 1・3）。
	# worktree はリポジトリ配下（`<repo>/.worktrees/<branch-slug>`）に散るので、
	# 舐めるべき「根」がもう無い。ghq 配下の各リポジトリに訊いて回る。
	#
	# **slug はディレクトリ名から組む。** `slug_for_path` は git のブランチを
	# 見るので、worktree の中でブランチを切り替えると tmux にある名前と
	# 食い違い、**動いているセッションを「消えた」として候補に出す**（実測）。
	# 占有を名前で当てていることが根本原因で、直すのは I1（照合を cwd へ。
	# ADR-0002 決定 3）の仕事。
	if have "$CCS_GHQ_BIN"; then
		"$CCS_GHQ_BIN" list -p 2>/dev/null | while IFS= read -r _repo; do
			[ -n "$_repo" ] || continue
			_rp=$(abs_dir "$_repo" 2>/dev/null) || continue
			[ -d "${_rp}/${CCS_WORKTREE_DIR}" ] || continue
			_repo_slug=$(slug_for_path "$_rp")
			for _br_dir in "${_rp}/${CCS_WORKTREE_DIR}"/*; do
				[ -d "$_br_dir" ] || continue
				_slug="${_repo_slug}@$(basename "$_br_dir")"
				tmux_session_exists "${CCS_PREFIX}${_slug}" && continue
				_u=$(restore_latest_in "$(transcript_dir_for "$_br_dir")") || continue
				restore_is_fresh "$(transcript_path "$_br_dir" "$_u")" || continue
				printf '%s\t%s\t%s\n' "$_slug" "$_br_dir" "$_u"
			done
		done
	fi

	# 4. tmux セッションごと消えたリポジトリのセッション。
	#
	# **印のある会話ログだけを拾う**（上のコメント）。slug の決定は
	# `ghq list` を舐めるので安くない ── 会話ログの検査を全部通ってから呼ぶ。
	have "$CCS_GHQ_BIN" || return 0
	"$CCS_GHQ_BIN" list -p 2>/dev/null | while IFS= read -r _repo; do
		[ -n "$_repo" ] || continue
		_rp=$(abs_dir "$_repo" 2>/dev/null) || continue
		_u=$(restore_latest_in "$(transcript_dir_for "$_rp")") || continue
		_f=$(transcript_path "$_rp" "$_u")
		restore_is_fresh "$_f" || continue
		restore_started_by_ccs "$_f" || continue

		_slug=$(slug_for_path "$_rp")
		[ "$_slug" = "$CCS_HUB_SLUG" ] && continue
		tmux_session_exists "${CCS_PREFIX}${_slug}" && continue
		printf '%s\t%s\t%s\n' "$_slug" "$_rp" "$_u"
	done
}

# 名前で指された 1 つを slug とパスに落とす。結果は CCS_RESOLVED_*。
restore_resolve_one() {
	case $1 in
	tmp | --tmp)
		die "$EX_USAGE" "restore: tmp は新しい枠を取る綴りです。戻す枠は番号まで指定してください: ccs restore tmp-1"
		;;
	tmp-*)
		# **枠は `resolve_target` に通さない。** あちらは「空いている枠を取る」
		# ので、名指しした番号とは違う枠を返す。
		_n=${1#tmp-}
		if ! is_uint "$_n" || [ "$_n" -lt 1 ]; then
			die "$EX_USAGE" "restore: 作業枠は tmp-<番号> の形で指定してください: $1"
		fi
		CCS_RESOLVED_SLUG=$1
		CCS_RESOLVED_PATH=$(restore_abs_under "$CCS_SCRATCH_ROOT" "$_n")
		;;
	*)
		# hub の予約語もここで弾かれる（resolve_target が案内を出す）。
		resolve_target "$1"
		;;
	esac
}

# その slug / パスで戻すべき uuid を決める。無ければ 1 を返す。
#
#   --session-id > 止まったペインが覚えている uuid > 会話ログの最新
#
# ペインを会話ログより優先するのは、**そのペインが何だったかを知っているのは
# ペインだけ**だから。同じ場所で別の会話を立てていれば、最新の会話ログは
# そのペインの会話ではない。
restore_uuid_for() {
	if [ -n "$CCS_RESTORE_SESSION_ID" ]; then
		printf '%s' "$CCS_RESTORE_SESSION_ID"
		return 0
	fi

	if tmux_session_exists "${CCS_PREFIX}${1}"; then
		_u=$(pane_session_id_for "${CCS_PREFIX}${1}")
		if [ -n "$_u" ]; then
			printf '%s' "$_u"
			return 0
		fi
	fi

	restore_latest_in "$(transcript_dir_for "$2")"
}

# 戻せない理由。無ければ空を出す。**dry-run でも同じ判定を通す**ので、
# ここで実体を作らない。
restore_reject_reason() {
	_path=$1
	_file=$(transcript_path "$1" "$2")

	if [ ! -f "$_file" ]; then
		printf '会話ログがありません（%s）' "$(tilde_path "$_file")"
		return 0
	fi

	# 作業ディレクトリが要る。**枠だけは作り直してよい** ── ccs が作る空の
	# ディレクトリなので、`ccs gc` が消していても失うものが無い。
	if [ ! -d "$_path" ]; then
		_scratch=$(abs_dir "$CCS_SCRATCH_ROOT" 2>/dev/null) || _scratch=$CCS_SCRATCH_ROOT
		if [ "$(dirname "$_path")" != "$_scratch" ]; then
			printf '作業ディレクトリがありません（%s）' "$(tilde_path "$_path")"
			return 0
		fi
	fi

	# エンコード規則の答え合わせ（restore_cwd_of のコメント）。
	_logged=$(restore_cwd_of "$_file")
	if [ -n "$_logged" ] && [ "$_logged" != "$_path" ]; then
		printf '会話ログの cwd が違います（%s）' "$(tilde_path "$_logged")"
		return 0
	fi
}

# 1 本ぶん立て直す。冪等性の判定と検査は呼ぶ側でやる。
restore_launch() {
	_slug=$1
	_path=$2
	_uuid=$3
	_session="${CCS_PREFIX}${_slug}"

	# **止まったペインは使い回さず、畳んでから立てる**（hub と同じ）。
	# 前の claude の出力が残ったまま新しいものが動くと、状態が読めなくなる。
	if tmux_session_exists "$_session"; then
		"$CCS_TMUX_BIN" kill-session -t "$_session" 2>/dev/null || true
	fi

	if [ ! -d "$_path" ]; then
		mkdir -p "$_path" || {
			warn "ccs: 作業ディレクトリを作れません: ${_path}"
			return 1
		}
	fi

	ensure_trust "$_path" "$_slug"

	# **`-n` を渡さない。** 戻す会話には既に名前が付いていて、アプリの一覧に
	# 出ているのはその名前（実測。人が付けた名前がそのまま残る）。ここで slug を
	# 被せると、戻した瞬間に `tmp-2` へ改名され、**探している名前のほうが消える**。
	# 新規に立てるとき（`ccs new`）と違うのはここだけ。
	#
	# 末尾の `exec $SHELL` は `ccs new` と同じ理由（design.md §4.3）。
	_cmd="$(shq "$CCS_CLAUDE_BIN") --resume $(shq "$_uuid")"
	_cmd="${_cmd}; exec $(shq "${SHELL:-/bin/sh}")"

	"$CCS_TMUX_BIN" new-session -d -s "$_session" -c "$_path" sh -c "$_cmd"
}

# `--list` の出力。その場所に残っている会話を新しい順に並べる。
restore_list_conversations() {
	_dir=$(transcript_dir_for "$2")

	printf '%s  %s\n' "$1" "$(tilde_path "$2")"

	# shellcheck disable=SC2012  # ファイル名は <uuid>.jsonl 固定なので ls で安全
	_files=$(ls -t "$_dir"/*.jsonl 2>/dev/null) || _files=''
	if [ -z "$_files" ]; then
		printf '  会話ログはありません（%s）\n\n' "$(tilde_path "$_dir")"
		return 0
	fi

	printf '%s\n' "$_files" | while IFS= read -r _f; do
		[ -n "$_f" ] || continue
		printf '  %-36s  %-16s  %s\n' \
			"$(basename "$_f" .jsonl)" \
			"$(restore_mtime_of "$_f")" \
			"$(restore_title_of "$_f" || printf '-')"
	done
	printf '\n'
}

# 表示用の mtime。**`date -r <ファイル>` は BSD と GNU の両方にある**
# （GNU では --reference）。取れない環境では表示を諦める。
restore_mtime_of() {
	date -r "$1" '+%Y-%m-%d %H:%M' 2>/dev/null || printf '-'
}

cmd_restore() {
	require_deps

	_apply=''
	_all=''
	_list=''
	_ntargets=0
	CCS_RESTORE_SESSION_ID=''

	# **オプションと対象は混ざる**（`ccs restore tmp-1 --yes`）ので 2 周する。
	# `$@` を崩さないのは、空白を含むパスを対象に取れるようにするため。
	_want_sid=''
	for _arg in "$@"; do
		if [ -n "$_want_sid" ]; then
			CCS_RESTORE_SESSION_ID=$_arg
			_want_sid=''
			continue
		fi
		case $_arg in
		-y | --yes) _apply=1 ;;
		--all) _all=1 ;;
		--list) _list=1 ;;
		--session-id) _want_sid=1 ;;
		-*) die "$EX_USAGE" "restore: 知らないオプション: ${_arg}" ;;
		*) _ntargets=$((_ntargets + 1)) ;;
		esac
	done
	[ -z "$_want_sid" ] || die "$EX_USAGE" 'restore: --session-id に uuid がありません'

	if [ -n "$CCS_RESTORE_SESSION_ID" ] && [ "$_ntargets" -ne 1 ]; then
		die "$EX_USAGE" 'restore: --session-id は戻す先を 1 つ指定したときだけ使えます（例: ccs restore tmp-1 --session-id <uuid>）'
	fi

	# --- 候補を作る ---

	_rows=''
	if [ "$_ntargets" -gt 0 ]; then
		# **名指しは古さで絞らない。** 人が名前を打っているなら、1 か月前の
		# 会話でもそれが意図。
		_want_sid=''
		for _arg in "$@"; do
			if [ -n "$_want_sid" ]; then
				_want_sid=''
				continue
			fi
			case $_arg in
			--session-id)
				_want_sid=1
				continue
				;;
			-*) continue ;;
			esac

			restore_resolve_one "$_arg"
			_slug=$CCS_RESOLVED_SLUG
			_path=$CCS_RESOLVED_PATH
			_uuid=$(restore_uuid_for "$_slug" "$_path") || _uuid=''
			[ -n "$_uuid" ] ||
				die "$EX_FAIL" "${_slug} に戻せる会話が見つかりません（$(tilde_path "$(transcript_dir_for "$_path")")）"
			_rows="${_rows}${_slug}	${_path}	${_uuid}
"
		done
	else
		[ -z "$_all" ] || CCS_RESTORE_MAX_AGE=0
		_rows=$(restore_candidates)
	fi

	if [ -z "$_rows" ]; then
		printf '立て直せるセッションはありません。\n'
		return 0
	fi

	# --- 会話の一覧だけ見せて終わる ---

	if [ -n "$_list" ]; then
		printf '%s\n' "$_rows" | while IFS="$(printf '\t')" read -r _slug _path _uuid; do
			[ -n "$_slug" ] || continue
			restore_list_conversations "$_slug" "$_path"
		done
		printf '戻すものを選ぶ: ccs restore <slug> --session-id <uuid> --yes\n'
		return 0
	fi

	# --- 仕分ける ---
	#
	# 分類はパイプの中（サブシェル）でやり、結果を文字列で受け取る。
	# ループの中で変数を溜めるとサブシェルの外に出てこない（`ccs gc` と同じ形）。
	_sorted=$(printf '%s\n' "$_rows" |
		while IFS="$(printf '\t')" read -r _slug _path _uuid; do
			[ -n "$_slug" ] || continue
			# 生きているものは触らない（冪等性）。
			if live_session_id_for "$_slug" >/dev/null 2>&1; then
				printf 'alive\t%s\t%s\t%s\n' "$_slug" "$_path" "$_uuid"
				continue
			fi
			_why=$(restore_reject_reason "$_path" "$_uuid")
			if [ -n "$_why" ]; then
				printf 'skip\t%s\t%s\n' "$_slug" "$_why"
			else
				printf 'ready\t%s\t%s\t%s\n' "$_slug" "$_path" "$_uuid"
			fi
		done)

	_ready=$(printf '%s\n' "$_sorted" | sed -n 's/^ready\t//p')
	_alive=$(printf '%s\n' "$_sorted" | sed -n 's/^alive\t//p')
	_skipped=$(printf '%s\n' "$_sorted" | sed -n 's/^skip\t//p')

	# slug の最大幅に合わせる（`ccs ls` と同じ）。
	_w=$(printf '%s\n' "$_sorted" |
		awk -F'\t' 'NF > 1 && length($2) > m { m = length($2) } END { print (m < 4 ? 4 : m) }')

	# --- 報告 ---

	if [ -n "$_ready" ]; then
		printf '立て直せるセッション:\n'
		printf '%s\n' "$_ready" | while IFS="$(printf '\t')" read -r _slug _path _uuid; do
			[ -n "$_slug" ] || continue
			_f=$(transcript_path "$_path" "$_uuid")
			printf "  %-${_w}s  %-16s  %-36s  %s\n" \
				"$_slug" "$(restore_mtime_of "$_f")" "$_uuid" \
				"$(restore_title_of "$_f" || printf '-')"
		done
		printf '\n'
	fi

	if [ -n "$_alive" ]; then
		printf '生きているので触りません:\n'
		printf '%s\n' "$_alive" | while IFS="$(printf '\t')" read -r _slug _rest; do
			[ -n "$_slug" ] || continue
			printf '  %s\n' "$_slug"
		done
		printf '\n'
	fi

	if [ -n "$_skipped" ]; then
		printf '戻せません:\n'
		printf '%s\n' "$_skipped" | while IFS="$(printf '\t')" read -r _slug _why; do
			[ -n "$_slug" ] || continue
			printf "  %-${_w}s  %s\n" "$_slug" "$_why"
		done
		printf '\n'
	fi

	[ -n "$_ready" ] || return 0

	if [ -z "$_apply" ]; then
		printf '実行するには: ccs restore --yes\n'
		printf '別の会話を選ぶ: ccs restore <slug> --list\n'
		return 0
	fi

	# --- 実行 ---
	#
	# **全部立ててから、登録を待つ。** 1 本ずつ待つと待ち時間が本数ぶん積み
	# 上がる（1 本あたり最大 CCS_NEW_TIMEOUT 秒）。同時に起動しておけば、
	# 待つのはいちばん遅い 1 本ぶんで済む。
	_launched=$(printf '%s\n' "$_ready" |
		while IFS="$(printf '\t')" read -r _slug _path _uuid; do
			[ -n "$_slug" ] || continue
			if restore_launch "$_slug" "$_path" "$_uuid"; then
				printf '%s\t%s\n' "$_slug" "$_uuid"
			else
				warn "ccs: 立て直せませんでした: ${CCS_PREFIX}${_slug}"
			fi
		done)

	# 待った結果も同じ形で受け取る。**報告は stdout**（gc と同じ）だが、
	# パイプの中で出すと捕まってしまうので、仕分けてから出す。
	_waited=$(printf '%s\n' "$_launched" |
		while IFS="$(printf '\t')" read -r _slug _uuid; do
			[ -n "$_slug" ] || continue
			if wait_for_registration "$_uuid"; then
				printf 'ok\t%s\t%s\n' "$_slug" "$_uuid"
			else
				printf 'ng\t%s\n' "$_slug"
			fi
		done)

	printf '%s\n' "$_waited" | sed -n 's/^ok\t//p' |
		while IFS="$(printf '\t')" read -r _slug _uuid; do
			[ -n "$_slug" ] || continue
			printf '戻しました: %s%s（%s）\n' "$CCS_PREFIX" "$_slug" "$_uuid"
		done

	_failed=$(printf '%s\n' "$_waited" | sed -n 's/^ng\t//p')
	[ -z "$_failed" ] || {
		printf '%s\n' "$_failed" | while IFS= read -r _slug; do
			[ -n "$_slug" ] || continue
			warn "ccs: ${_slug} は ${CCS_NEW_TIMEOUT} 秒で登録されませんでした。"
			warn "  乗り込んで確かめる: ccs attach ${_slug}"
		done
		exit "$EX_FAIL"
	}
}

# ---------------------------------------------------------------------------
# 設定の検査と表示
# ---------------------------------------------------------------------------

is_uint() {
	case ${1:-} in
	'' | *[!0-9]*) return 1 ;;
	esac
	return 0
}

# 設定が壊れた状態で走らせない。
#
# **落とすのは、黙って既定値に戻すより良いから。** 綴りを間違えた設定が
# 無言で無視されると、hub の名前が変わっていないことに誰も気づかない。
validate_config() {
	case $CCS_REMOTE_CONTROL in
	auto | on | off) ;;
	*) die "$EX_USAGE" "CCS_REMOTE_CONTROL は auto / on / off のどれかです: ${CCS_REMOTE_CONTROL}" ;;
	esac

	case $CCS_HUB_AUTOSTART in
	on | login | off) ;;
	*) die "$EX_USAGE" "CCS_HUB_AUTOSTART は on / login / off のどれかです: ${CCS_HUB_AUTOSTART}" ;;
	esac

	[ -n "$CCS_HUB_SLUG" ] ||
		die "$EX_USAGE" 'CCS_HUB_SLUG が空です'
	[ "$CCS_HUB_SLUG" = "$(sanitize_slug "$CCS_HUB_SLUG")" ] ||
		die "$EX_USAGE" "CCS_HUB_SLUG に tmux で使えない文字が入っています（使えるのは A-Z a-z 0-9 _ @ -）: ${CCS_HUB_SLUG}"
	[ "$CCS_HUB_SLUG" != 'tmp' ] ||
		die "$EX_USAGE" 'CCS_HUB_SLUG に tmp は使えません（使い捨て作業枠の予約語です）'

	for _v in CCS_SCRATCH_SLOTS CCS_NEW_TIMEOUT CCS_RESTORE_MAX_AGE CCS_HUB_RC_TIMEOUT CCS_HUB_BACKOFF_WINDOW CCS_HUB_BACKOFF_MAX CCS_HUB_AGENT_INTERVAL; do
		eval "_n=\$$_v"
		is_uint "$_n" || die "$EX_USAGE" "${_v} は 0 以上の整数です: ${_n}"
	done
}

config_source_of() {
	eval "printf '%s' \"\${CCS_SRC_$1:-default}\""
}

cmd_config() {
	_json=''
	while [ $# -gt 0 ]; do
		case $1 in
		--json) _json=1 ;;
		*) die "$EX_USAGE" "config: 知らないオプション: $1" ;;
		esac
		shift
	done

	if [ -n "$_json" ]; then
		printf '{"configFile":%s,"configFileExists":%s,"settings":{' \
			"$(json_str "$CCS_CONFIG_FILE")" \
			"$([ -f "$CCS_CONFIG_FILE" ] && printf 'true' || printf 'false')"
		_first=1
		for _k in $CCS_CONFIG_KEYS; do
			[ "$_first" = 1 ] || printf ','
			_first=0
			eval "_v=\$$_k"
			printf '%s:{"value":%s,"source":%s}' \
				"$(json_str "$_k")" "$(json_str "$_v")" \
				"$(json_str "$(config_source_of "$_k")")"
		done
		printf '}}\n'
	else
		printf '%-24s %-40s %s\n' 'KEY' 'VALUE' 'SOURCE'
		for _k in $CCS_CONFIG_KEYS; do
			eval "_v=\$$_k"
			printf '%-24s %-40s %s\n' "$_k" "$(tilde_path "$_v")" "$(config_source_of "$_k")"
		done
		printf '\n設定ファイル: %s' "$(tilde_path "$CCS_CONFIG_FILE")"
		if [ -f "$CCS_CONFIG_FILE" ]; then
			printf '\n'
		else
			printf '（まだありません）\n'
		fi
		printf 'env > 設定ファイル > 既定値 の順で効きます。詳細は docs/configuration.md。\n'
	fi

	# **表を出してから検査する。** 値が不正なときこそ、その値を見たい。
	validate_config
}

# ---------------------------------------------------------------------------
# hub
#
# hub は「スマホから唯一触る 1 本」。落ちると ccs を叩く経路ごと消えるので、
# 他のセッションと違って **自動で戻ってくる**ことを保証する。設計と運用は
# docs/hub.md。
#
# 名前も置き場所も自動起動も設定で変えられる（docs/configuration.md）。
# `hub` という名前のリポジトリを持っている人が詰まないようにするため。
# ---------------------------------------------------------------------------

hub_session() {
	printf '%s%s' "$CCS_PREFIX" "$CCS_HUB_SLUG"
}

hub_state_file() {
	printf '%s/state.json' "$CCS_HUB_HOME"
}

hub_log_file() {
	printf '%s/hub.log' "$CCS_HUB_HOME"
}

hub_pause_file() {
	printf '%s/paused' "$CCS_HUB_HOME"
}

# Remote Control を要求するか（auto / on なら要求する）。
hub_rc_wanted() {
	[ "$CCS_REMOTE_CONTROL" != 'off' ]
}

# JSONL で 1 行残す。
#
# **healthy のたびには書かない。** 5 分ごとの監視で「異常なし」を積むと、
# 肝心の異常が埋もれる。残すのは変化と失敗だけ。
hub_log() {
	_hb_event=$1
	_hb_detail=${2:-}
	# shellcheck disable=SC2016  # $ts / $event / $detail は jq の変数
	_hb_log_filter='{ts:$ts,event:$event,detail:$detail}'
	mkdir -p "$CCS_HUB_HOME" 2>/dev/null || return 0
	"$CCS_JQ_BIN" -c -n \
		--arg ts "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
		--arg event "$_hb_event" \
		--arg detail "$_hb_detail" \
		"$_hb_log_filter" >>"$(hub_log_file)" 2>/dev/null || true
}

# state.json を jq のフィルタで更新する。
# 壊れた JSON を書かないよう、書いてから検査して mv する（trust_accept と同じ作法）。
hub_state_update() {
	_hb_filter=$1
	shift
	mkdir -p "$CCS_HUB_HOME" 2>/dev/null || return 1
	_hb_file=$(hub_state_file)
	[ -f "$_hb_file" ] || printf '{"restarts":[]}\n' >"$_hb_file"

	_hb_tmp="${_hb_file}.ccs.$$"
	if "$CCS_JQ_BIN" "$@" "$_hb_filter" "$_hb_file" >"$_hb_tmp" 2>/dev/null &&
		"$CCS_JQ_BIN" -e . "$_hb_tmp" >/dev/null 2>&1; then
		mv "$_hb_tmp" "$_hb_file"
		return 0
	fi

	rm -f "$_hb_tmp"
	warn "ccs: hub の状態ファイルを更新できませんでした: ${_hb_file}"
	return 1
}

hub_state_get() {
	_hb_file=$(hub_state_file)
	[ -f "$_hb_file" ] || return 1
	_hb_v=$("$CCS_JQ_BIN" -r "$1 // empty" "$_hb_file" 2>/dev/null) || return 1
	[ -n "$_hb_v" ] || return 1
	printf '%s\n' "$_hb_v"
}

hub_record_restart() {
	# 直近 20 件だけ残す。履歴そのものが目的ではなく、暴走の検知が目的。
	# shellcheck disable=SC2016  # $now は jq の変数。シェルに展開させてはいけない
	hub_state_update '.restarts = (((.restarts // []) + [($now | tonumber)]) | .[-20:])' \
		--arg now "$(date +%s)" || true
}

# 窓の中で規定回数以上の再起動をしていれば真。
hub_backoff_tripped() {
	_hb_file=$(hub_state_file)
	[ -f "$_hb_file" ] || return 1
	[ "$CCS_HUB_BACKOFF_MAX" -gt 0 ] || return 1
	# shellcheck disable=SC2016  # $now / $w は jq の変数
	_hb_n=$("$CCS_JQ_BIN" -r \
		--arg now "$(date +%s)" --arg w "$CCS_HUB_BACKOFF_WINDOW" \
		'[(.restarts // [])[] | select(. > (($now | tonumber) - ($w | tonumber)))] | length' \
		"$_hb_file" 2>/dev/null) || return 1
	[ "${_hb_n:-0}" -ge "$CCS_HUB_BACKOFF_MAX" ]
}

# ペインに認証要求が出ていないか。
#
# **これが出ているときは自動で直せない。** 立て直しても同じ画面で止まるだけ
# なので、再起動を試みずに人を待つ（docs/hub.md「認証切れ」）。
hub_pane_needs_login() {
	"$CCS_TMUX_BIN" capture-pane -p -t "$(hub_session)" 2>/dev/null |
		tail -40 |
		grep -qiE '/login|login expire|invalid api key|not logged in|authentication (failed|error)'
}

# hub の状態を 1 語で返す。**副作用を持たない。**
hub_state() {
	[ -f "$(hub_pause_file)" ] && {
		printf 'paused\n'
		return 0
	}

	if ! tmux_session_exists "$(hub_session)"; then
		printf 'absent\n'
		return 0
	fi

	if ! live_session_id_for "$CCS_HUB_SLUG" >/dev/null 2>&1; then
		if hub_pane_needs_login; then
			printf 'needs-login\n'
		else
			printf 'stopped\n'
		fi
		return 0
	fi

	if hub_rc_wanted && ! live_bridge_for "$CCS_HUB_SLUG" >/dev/null 2>&1; then
		printf 'no-rc\n'
		return 0
	fi

	printf 'healthy\n'
}

hub_exit_code_for() {
	case $1 in
	healthy) printf '%s\n' "$EX_OK" ;;
	no-rc) printf '%s\n' "$EX_HUB_NO_RC" ;;
	stopped) printf '%s\n' "$EX_HUB_STOPPED" ;;
	absent) printf '%s\n' "$EX_HUB_ABSENT" ;;
	needs-login) printf '%s\n' "$EX_HUB_NEEDS_LOGIN" ;;
	paused) printf '%s\n' "$EX_HUB_PAUSED" ;;
	needs-attention) printf '%s\n' "$EX_HUB_ATTENTION" ;;
	*) printf '%s\n' "$EX_FAIL" ;;
	esac
}

# hub の作業ディレクトリを用意する。
#
# **既にあるファイルは上書きしない。** ここに置くのは出発点であって、
# 中身は使う人のもの。
# CCS_HUB_HOME を symlink を辿った形に揃える。
#
# **揃えないと trust の比較が外れる。** ccs が渡す cwd は pwd -P を通った形に
# なるので、片方だけ生のままだと一致しない（macOS の /var → /private/var で
# 実際に踏んだ。ghq root でも同じことが起きている）。
hub_normalize_home() {
	_home=$(abs_dir "$CCS_HUB_HOME" 2>/dev/null) || return 0
	CCS_HUB_HOME=$_home
}

hub_ensure_home() {
	mkdir -p "${CCS_HUB_HOME}/.claude" ||
		die "$EX_FAIL" "hub の作業ディレクトリを作れません: ${CCS_HUB_HOME}"
	hub_normalize_home

	if [ ! -f "${CCS_HUB_HOME}/CLAUDE.md" ]; then
		cat >"${CCS_HUB_HOME}/CLAUDE.md" <<EOF
# hub

このセッションは **hub** です（ccs が用意しました）。役割は 1 つだけ。

**自分では作業しない。立てる・聞く・畳むの司令塔に徹する。**

- 仕事は \`ccs new <target>\` で別セッションを立て、\`SendMessage\` で頼む
- 全体を見るときは \`ListAgents\`（生きているもの）と \`ccs ls\`（tmux 側）
- 他のセッションに頼むのは**読み取りだけ**。コミット・PR 作成・外部送信のような
  副作用のある作業を投げない（権限を判断した主体と手を動かす主体がずれるため）
- **自分自身（\`${CCS_PREFIX}${CCS_HUB_SLUG}\`）を畳まない。** 落とすと、スマホから
  操作する経路そのものが消える。立て直しは \`ccs hub restart\`
- \`ccs kill\` / \`ccs gc --yes\` は、人がそう言ったときだけ

このファイルは編集して構いません（ccs は上書きしません）。
EOF
	fi

	if [ ! -f "${CCS_HUB_HOME}/.claude/settings.json" ]; then
		cat >"${CCS_HUB_HOME}/.claude/settings.json" <<'EOF'
{
  "permissions": {
    "ask": [
      "Bash(ccs kill:*)",
      "Bash(ccs gc:*)",
      "Bash(tmux kill-session:*)",
      "Bash(tmux kill-server:*)"
    ],
    "deny": [
      "Bash(ccs hub down:*)"
    ]
  }
}
EOF
	fi
}

# hub を tmux に立てる。立てるだけで、待ちも報告もしない。
# 使った uuid は CCS_HUB_LAUNCHED_UUID に入る（サブシェルで呼ばないこと）。
hub_launch() {
	_hb_resume=${1:-}

	hub_ensure_home
	ensure_trust "$CCS_HUB_HOME" "$CCS_HUB_SLUG"

	if [ -n "$_hb_resume" ]; then
		CCS_HUB_LAUNCHED_UUID=$_hb_resume
		_hb_cmd="$(shq "$CCS_CLAUDE_BIN") --resume $(shq "$_hb_resume") -n $(shq "$CCS_HUB_SLUG")"
	else
		CCS_HUB_LAUNCHED_UUID=$(new_uuid)
		_hb_cmd="$(shq "$CCS_CLAUDE_BIN") -n $(shq "$CCS_HUB_SLUG") --session-id $(shq "$CCS_HUB_LAUNCHED_UUID")"
	fi

	# **RC の名前を明示する。** 渡さないと、アプリ側の名前は会話の内容から
	# 自動で決まり、日によって変わる。hub だけは名前が動くと見失う。
	if hub_rc_wanted; then
		_hb_cmd="${_hb_cmd} --remote-control $(shq "$CCS_HUB_SLUG")"
	fi

	_hb_cmd="${_hb_cmd}; exec $(shq "${SHELL:-/bin/sh}")"

	"$CCS_TMUX_BIN" new-session -d -s "$(hub_session)" -c "$CCS_HUB_HOME" sh -c "$_hb_cmd" ||
		die "$EX_FAIL" "tmux セッションを作れませんでした: $(hub_session)"
}

# Remote Control の登録が付くまで待つ。
hub_wait_bridge() {
	_hb_deadline=$(($(date +%s) + CCS_HUB_RC_TIMEOUT))
	while [ "$(date +%s)" -lt "$_hb_deadline" ]; do
		if live_bridge_for "$CCS_HUB_SLUG" >/dev/null 2>&1; then
			return 0
		fi
		sleep 0.2
	done
	return 1
}

hub_emit_json() {
	printf '{"slug":%s,"state":%s,"sessionId":%s,"previousSessionId":%s,"path":%s,"tmux":%s,"bridge":%s,"transcript":%s,"created":%s}\n' \
		"$(json_str "$CCS_HUB_SLUG")" "$(json_str "$1")" "$(json_str "$2")" \
		"$(json_str "$3")" "$(json_str "$CCS_HUB_HOME")" "$(json_str "$(hub_session)")" \
		"$(json_str "$4")" "$(json_str "$(transcript_path "$CCS_HUB_HOME" "$2")")" "$5"
}

# 立てて、登録を待って、結果を報告する。up と restart の共通部分。
#   $1 resume する uuid（空なら新規）
#   $2 直前の uuid（記録用。空でよい）
#   $3 ログに残すイベント名
#   $4 quiet なら 1
hub_start_and_report() {
	_hb_resume=$1
	_hb_prev=$2
	_hb_event=$3
	_hb_quiet=$4

	hub_launch "$_hb_resume"
	_hb_uuid=$CCS_HUB_LAUNCHED_UUID

	if ! wait_for_registration "$_hb_uuid"; then
		hub_log 'failed' "登録されませんでした（${CCS_NEW_TIMEOUT} 秒）"
		warn "ccs: hub が ${CCS_NEW_TIMEOUT} 秒で登録されませんでした。"
		warn ''
		warn 'ペインの中身:'
		warn '---'
		"$CCS_TMUX_BIN" capture-pane -p -t "$(hub_session)" 2>/dev/null | tail -20 >&2 || true
		warn '---'
		warn ''
		warn '信頼確認かログインで止まっている可能性があります。'
		warn '  乗り込んで確かめる: ccs hub attach'
		# **消さない。** 何に詰まっていたのかが分からなくなる。
		exit "$EX_FAIL"
	fi

	# shellcheck disable=SC2016  # $id / $prev / $now は jq の変数
	hub_state_update '.sessionId = $id | .previousSessionId = $prev | .startedAt = ($now | tonumber)' \
		--arg id "$_hb_uuid" --arg prev "$_hb_prev" --arg now "$(date +%s)" || true

	_hb_bridge=''
	if hub_rc_wanted; then
		if hub_wait_bridge; then
			_hb_bridge=$(live_bridge_for "$CCS_HUB_SLUG" || printf '')
		else
			hub_log 'no-rc' "Remote Control が ${CCS_HUB_RC_TIMEOUT} 秒で付きませんでした"
			warn "ccs: hub は立ちましたが、Remote Control が付きませんでした（${CCS_HUB_RC_TIMEOUT} 秒）。"
			warn 'スマホのアプリには出ません。ローカルからは使えます。'
			warn ''
			warn '  設定を確かめる: ccs config'
			warn '  RC を使わない運用にする: CCS_REMOTE_CONTROL=off'
			warn '  乗り込んで確かめる: ccs hub attach'
			hub_emit_json 'no-rc' "$_hb_uuid" "$_hb_prev" '' true
			exit "$EX_HUB_NO_RC"
		fi
	fi

	hub_log "$_hb_event" "sessionId=${_hb_uuid}"
	[ -n "$_hb_quiet" ] || hub_emit_json 'healthy' "$_hb_uuid" "$_hb_prev" "$_hb_bridge" true
}

# 立っている hub の uuid を回収してから畳む。回収した uuid を返す。
hub_teardown() {
	_hb_old=$(live_session_id_for "$CCS_HUB_SLUG" 2>/dev/null || true)
	[ -n "$_hb_old" ] || _hb_old=$(pane_session_id_for "$(hub_session)" 2>/dev/null || true)

	if tmux_session_exists "$(hub_session)"; then
		"$CCS_TMUX_BIN" kill-session -t "$(hub_session)" 2>/dev/null || true
	fi

	printf '%s' "$_hb_old"
}

cmd_hub_up() {
	require_deps

	_hb_force=''
	_hb_quiet=''
	while [ $# -gt 0 ]; do
		case $1 in
		-f | --force) _hb_force=1 ;;
		-q | --quiet) _hb_quiet=1 ;;
		*) die "$EX_USAGE" "hub up: 知らないオプション: $1" ;;
		esac
		shift
	done

	_hb_state=$(hub_state)

	if [ "$_hb_state" = 'paused' ]; then
		if [ -n "$_hb_force" ]; then
			rm -f "$(hub_pause_file)"
			hub_log 'resumed' '--force で再開'
			_hb_state=$(hub_state)
		else
			[ -n "$_hb_quiet" ] || warn "ccs: hub は止められています（$(tilde_path "$(hub_pause_file)")）。"
			[ -n "$_hb_quiet" ] || warn '  再開する: ccs hub up --force'
			exit "$EX_HUB_PAUSED"
		fi
	fi

	if [ "$_hb_state" = 'healthy' ]; then
		if [ -z "$_hb_quiet" ]; then
			hub_emit_json 'healthy' \
				"$(live_session_id_for "$CCS_HUB_SLUG" || printf '')" \
				"$(hub_state_get '.previousSessionId' || printf '')" \
				"$(live_bridge_for "$CCS_HUB_SLUG" 2>/dev/null || printf '')" false
		fi
		exit "$EX_OK"
	fi

	if [ "$_hb_state" = 'needs-login' ]; then
		hub_log 'needs-login' 'ペインに認証要求が出ています'
		warn 'ccs: hub の認証が切れています。**自動では直せません。**'
		warn ''
		warn '  乗り込んで /login する: ccs hub attach'
		warn ''
		warn '直したあとは自動監視がそのまま拾います（何もしなくて構いません）。'
		exit "$EX_HUB_NEEDS_LOGIN"
	fi

	if [ -z "$_hb_force" ] && hub_backoff_tripped; then
		hub_log 'backoff' "直近 ${CCS_HUB_BACKOFF_WINDOW} 秒で ${CCS_HUB_BACKOFF_MAX} 回以上再起動しています"
		warn "ccs: hub の再起動が続いているため止めています（直近 ${CCS_HUB_BACKOFF_WINDOW} 秒で ${CCS_HUB_BACKOFF_MAX} 回以上）。"
		warn ''
		warn "  何が起きているか見る: ccs hub attach / tail $(tilde_path "$(hub_log_file)")"
		warn '  それでも立てる:       ccs hub up --force'
		exit "$EX_HUB_ATTENTION"
	fi

	_hb_prev=''
	case $_hb_state in
	no-rc | stopped)
		# **畳んでから立て直す。** ペインを使い回すと、前の claude の
		# 出力が残ったまま新しいものが動き、状態が読めなくなる。
		_hb_prev=$(hub_teardown)
		hub_record_restart
		hub_start_and_report '' "$_hb_prev" 'restart' "$_hb_quiet"
		;;
	absent)
		hub_record_restart
		hub_start_and_report '' '' 'start' "$_hb_quiet"
		;;
	*)
		die "$EX_FAIL" "hub の状態を判定できませんでした: ${_hb_state}"
		;;
	esac

	hub_restore_hint
}

# 「他も落ちている」ことだけ伝える。**立て直しはしない。**
#
# hub up は launchd から 5 分おきに走る。ここで他のセッションまで戻すと、
# 人が畳んだものが 5 分後に生き返る ── ccs は状態を持たないので、
# 「畳んだ」と「落ちた」を durable な情報から区別できない（design.md §2.1）。
# 区別できるのは打った本人だけなので、**復元は人が打つ `ccs restore` に残す。**
#
# 言うのは hub を実際に立て直したときだけ。生きているときは呼ばれる前に
# 返っているので、ここへ来るのは落ちていたときだけ ── 再起動の直後がまさに
# それで、そのとき他のセッションも一緒に消えている。
hub_restore_hint() {
	_hb_n=$(restore_candidates 2>/dev/null | grep -c . || true)
	[ "${_hb_n:-0}" -gt 0 ] 2>/dev/null || return 0
	warn ''
	warn "ccs: 止まっているセッションが ${_hb_n} 本あります（hub は立て直しました）。"
	warn '  見る:     ccs restore'
	warn '  立て直す: ccs restore --yes'
}

cmd_hub_status() {
	require_deps

	_hb_json=''
	while [ $# -gt 0 ]; do
		case $1 in
		--json) _hb_json=1 ;;
		*) die "$EX_USAGE" "hub status: 知らないオプション: $1" ;;
		esac
		shift
	done

	_hb_state=$(hub_state)
	if [ "$_hb_state" != 'healthy' ] && [ "$_hb_state" != 'paused' ] && hub_backoff_tripped; then
		_hb_state='needs-attention'
	fi

	_hb_id=$(live_session_id_for "$CCS_HUB_SLUG" 2>/dev/null || true)
	[ -n "$_hb_id" ] || _hb_id=$(pane_session_id_for "$(hub_session)" 2>/dev/null || true)
	[ -n "$_hb_id" ] || _hb_id=$(hub_state_get '.sessionId' || printf '')
	_hb_bridge=$(live_bridge_for "$CCS_HUB_SLUG" 2>/dev/null || printf '')
	_hb_restarts=$("$CCS_JQ_BIN" -r '(.restarts // []) | length' "$(hub_state_file)" 2>/dev/null || printf '0')

	if [ -n "$_hb_json" ]; then
		printf '{"slug":%s,"state":%s,"sessionId":%s,"tmux":%s,"path":%s,"bridge":%s,"remoteControl":%s,"restarts":%s,"paused":%s}\n' \
			"$(json_str "$CCS_HUB_SLUG")" "$(json_str "$_hb_state")" "$(json_str "$_hb_id")" \
			"$(json_str "$(hub_session)")" "$(json_str "$CCS_HUB_HOME")" \
			"$(json_str "$_hb_bridge")" "$(json_str "$CCS_REMOTE_CONTROL")" \
			"${_hb_restarts:-0}" \
			"$([ -f "$(hub_pause_file)" ] && printf 'true' || printf 'false')"
	else
		printf 'slug        %s\n' "$CCS_HUB_SLUG"
		printf 'state       %s\n' "$_hb_state"
		printf 'tmux        %s\n' "$(hub_session)"
		printf 'path        %s\n' "$(tilde_path "$CCS_HUB_HOME")"
		printf 'sessionId   %s\n' "${_hb_id:--}"
		printf 'bridge      %s\n' "${_hb_bridge:--}"
		printf 'RC          %s\n' "$CCS_REMOTE_CONTROL"
		case $_hb_state in
		healthy) ;;
		absent | stopped | no-rc) printf '\n直すには: ccs hub up\n' ;;
		needs-login) printf '\n認証が切れています。ccs hub attach して /login してください。\n' ;;
		paused) printf '\n止められています。再開: ccs hub up --force\n' ;;
		needs-attention) printf '\n再起動が続いています。ccs hub attach で中を見てください（強行: ccs hub up --force）。\n' ;;
		esac
	fi

	exit "$(hub_exit_code_for "$_hb_state")"
}

cmd_hub_restart() {
	require_deps

	_hb_resume=''
	_hb_quiet=''
	while [ $# -gt 0 ]; do
		case $1 in
		--resume) _hb_resume=1 ;;
		-q | --quiet) _hb_quiet=1 ;;
		*) die "$EX_USAGE" "hub restart: 知らないオプション: $1" ;;
		esac
		shift
	done

	# 止められていても restart は通す。**人が明示的に打っているため。**
	if [ -f "$(hub_pause_file)" ]; then
		rm -f "$(hub_pause_file)"
		hub_log 'resumed' 'restart で再開'
	fi

	_hb_prev=$(hub_teardown)

	_hb_with=''
	if [ -n "$_hb_resume" ]; then
		[ -n "$_hb_prev" ] || _hb_prev=$(hub_state_get '.sessionId' || printf '')
		if [ -n "$_hb_prev" ]; then
			_hb_with=$_hb_prev
		else
			warn 'ccs: 直前の sessionId が分からないので、新しい会話で立てます。'
		fi
	fi

	# **人が打った restart は歯止めに数えない。** 歯止めは「自動で立て直し
	# 続けるのを止める」ためのもので、人がその場にいるなら要らない。
	# ここで数えると、手で 3 回直した直後に自動復帰が止まる。
	hub_start_and_report "$_hb_with" "$_hb_prev" 'restart' "$_hb_quiet"
}

cmd_hub_down() {
	require_deps

	while [ $# -gt 0 ]; do
		case $1 in
		*) die "$EX_USAGE" "hub down: 知らないオプション: $1" ;;
		esac
	done

	mkdir -p "$CCS_HUB_HOME" 2>/dev/null || true
	_hb_prev=$(hub_teardown)
	date -u '+%Y-%m-%dT%H:%M:%SZ' >"$(hub_pause_file)"
	# shellcheck disable=SC2016  # $prev は jq の変数
	hub_state_update '.previousSessionId = $prev' --arg prev "$_hb_prev" || true
	hub_log 'paused' "sessionId=${_hb_prev}"

	printf 'hub を止めました。自動起動も止まります（%s があるあいだ）。\n' \
		"$(tilde_path "$(hub_pause_file)")"
	printf '\n  再開する:           ccs hub up --force\n'
	if [ -n "$_hb_prev" ]; then
		printf '  同じ会話に戻る:     ccs hub restart --resume\n'
	fi
}

cmd_hub_attach() {
	cmd_attach "$CCS_HUB_SLUG"
}

# 自分自身の絶対パス。自動起動の設定ファイルに書き込むため。
ccs_self_path() {
	case $0 in
	/*) printf '%s\n' "$0" ;;
	*/*) printf '%s/%s\n' "$(cd "$(dirname "$0")" && pwd -P)" "$(basename "$0")" ;;
	*) command -v "$0" 2>/dev/null || printf 'ccs\n' ;;
	esac
}

# 自動起動から呼ばれたときの PATH。
#
# **launchd / systemd は対話シェルの設定を読まない。** `-lc` でログインシェルに
# しても、PATH を `~/.zshrc` で足している環境（Homebrew の既定の入れ方がこれ）
# では tmux も claude も見つからず、`ccs hub up` が依存不足で即死する。実測で
# 踏んだ（`env -i ... zsh -lc 'command -v tmux'` が空）。
#
# 生成する側は、それらが見つかる環境で走っている。**そこで解決できた場所を
# ユニットに焼き込む**ことで、起動経路に依らず同じものを掴ませる。
hub_agent_path() {
	_hb_dirs=''
	for _hb_bin in "$CCS_CLAUDE_BIN" "$CCS_TMUX_BIN" "$CCS_JQ_BIN" "$CCS_GHQ_BIN" "$CCS_GIT_BIN" "$(ccs_self_path)"; do
		[ -n "$_hb_bin" ] || continue
		_hb_found=$(command -v "$_hb_bin" 2>/dev/null) || continue
		# ビルトインや関数は場所を持たない。絶対パスだけを採る。
		case $_hb_found in
		/*) ;;
		*) continue ;;
		esac
		_hb_dir=$(dirname "$_hb_found")
		case ":${_hb_dirs}:" in
		*":${_hb_dir}:"*) continue ;;
		esac
		_hb_dirs="${_hb_dirs:+${_hb_dirs}:}${_hb_dir}"
	done
	printf '%s' "${_hb_dirs:+${_hb_dirs}:}/usr/bin:/bin:/usr/sbin:/sbin"
}

hub_agent_unit_name() {
	printf '%s' "$CCS_HUB_AGENT_LABEL" | sed 's/[^A-Za-z0-9_-]/-/g'
}

hub_agent_plist() {
	_hb_mode=$1
	_hb_self=$(ccs_self_path)
	_hb_path=$(hub_agent_path)

	cat <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>${CCS_HUB_AGENT_LABEL}</string>

	<!-- ccs hub up は冪等。生きていれば何もせず、死んでいれば立て直す。 -->
	<key>ProgramArguments</key>
	<array>
		<string>${SHELL:-/bin/sh}</string>
		<string>-lc</string>
		<string>exec ${_hb_self} hub up --quiet</string>
	</array>

	<!-- launchd は対話シェルの設定を読まない。tmux / claude の在処を焼き込む。 -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>${_hb_path}</string>
	</dict>

	<key>RunAtLoad</key>
	<true/>
EOF

	if [ "$_hb_mode" = 'on' ]; then
		cat <<EOF

	<key>StartInterval</key>
	<integer>${CCS_HUB_AGENT_INTERVAL}</integer>
EOF
	fi

	cat <<EOF

	<key>StandardOutPath</key>
	<string>${CCS_HUB_HOME}/agent.log</string>
	<key>StandardErrorPath</key>
	<string>${CCS_HUB_HOME}/agent.log</string>
</dict>
</plist>
EOF
}

hub_agent_systemd_service() {
	_hb_self=$(ccs_self_path)
	_hb_path=$(hub_agent_path)
	cat <<EOF
[Unit]
Description=ccs hub (${CCS_HUB_SLUG})

[Service]
Type=oneshot
# systemd も対話シェルの設定を読まない。tmux / claude の在処を焼き込む。
Environment=PATH=${_hb_path}
# ccs hub up は冪等。生きていれば何もせず、死んでいれば立て直す。
ExecStart=${SHELL:-/bin/sh} -lc 'exec ${_hb_self} hub up --quiet'

[Install]
WantedBy=default.target
EOF
}

hub_agent_systemd_timer() {
	cat <<EOF
[Unit]
Description=ccs hub の死活監視 (${CCS_HUB_SLUG})

[Timer]
OnStartupSec=1min
OnUnitActiveSec=${CCS_HUB_AGENT_INTERVAL}
Unit=$(hub_agent_unit_name).service

[Install]
WantedBy=timers.target
EOF
}

cmd_hub_agent() {
	_hb_print=''
	_hb_mode=$CCS_HUB_AUTOSTART
	_hb_unit_only=''

	while [ $# -gt 0 ]; do
		case $1 in
		--print) _hb_print=1 ;;
		--autostart)
			_hb_mode=${2:-}
			shift
			;;
		# systemd は service と timer の 2 ファイルに分かれる。
		# **両方を 1 つのファイルに書くと壊れる**ので、片方だけ出せるようにする。
		--unit)
			_hb_unit_only=${2:-}
			shift
			;;
		*) die "$EX_USAGE" "hub agent: 知らないオプション: $1" ;;
		esac
		shift
	done

	case $_hb_mode in
	on | login | off) ;;
	*) die "$EX_USAGE" "hub agent: --autostart は on / login / off のどれかです: ${_hb_mode}" ;;
	esac

	case $_hb_unit_only in
	'' | service | timer) ;;
	*) die "$EX_USAGE" "hub agent: --unit は service / timer のどちらかです: ${_hb_unit_only}" ;;
	esac

	if [ "$_hb_mode" = 'off' ]; then
		warn 'ccs: 自動起動は off です（CCS_HUB_AUTOSTART=off）。'
		warn ''
		warn '  一時的に中身を見る:   ccs hub agent --print --autostart on'
		warn '  常時 on にする:       設定ファイルに CCS_HUB_AUTOSTART=on'
		warn '  手で立てる運用のまま: ccs hub up'
		exit "$EX_FAIL"
	fi

	_hb_unit=$(hub_agent_unit_name)

	case $(uname -s) in
	Darwin)
		_hb_dest="${HOME}/Library/LaunchAgents/${CCS_HUB_AGENT_LABEL}.plist"
		if [ -n "$_hb_print" ]; then
			hub_agent_plist "$_hb_mode"
			return 0
		fi
		printf '自動起動（launchd）の入れ方:\n\n'
		printf '  ccs hub agent --print > %s\n' "$(tilde_path "$_hb_dest")"
		# shellcheck disable=SC2016  # $(id -u) は人がそのまま打つ文字列
		printf '  launchctl bootstrap gui/$(id -u) %s\n' "$(tilde_path "$_hb_dest")"
		printf '\n止めるとき:\n\n'
		# shellcheck disable=SC2016  # 同上
		printf '  launchctl bootout gui/$(id -u)/%s\n' "$CCS_HUB_AGENT_LABEL"
		printf '  rm %s\n' "$(tilde_path "$_hb_dest")"
		printf '\n間隔 %s 秒 / モード %s。ログは %s。\n' \
			"$CCS_HUB_AGENT_INTERVAL" "$_hb_mode" "$(tilde_path "${CCS_HUB_HOME}/agent.log")"
		;;
	Linux)
		_hb_dest="${XDG_CONFIG_HOME:-${HOME}/.config}/systemd/user"
		if [ -n "$_hb_print" ]; then
			case $_hb_unit_only in
			service)
				hub_agent_systemd_service
				return 0
				;;
			timer)
				[ "$_hb_mode" = 'on' ] ||
					die "$EX_USAGE" "hub agent: timer は --autostart on のときだけです（いまは ${_hb_mode}）"
				hub_agent_systemd_timer
				return 0
				;;
			esac

			# 指定が無ければ両方を見出しつきで出す（読むため）。
			# **そのままリダイレクトしないこと。** 書き出すときは --unit を使う。
			printf '# --- %s/%s.service ---\n' "$_hb_dest" "$_hb_unit"
			hub_agent_systemd_service
			if [ "$_hb_mode" = 'on' ]; then
				printf '\n# --- %s/%s.timer ---\n' "$_hb_dest" "$_hb_unit"
				hub_agent_systemd_timer
			fi
			return 0
		fi
		printf '自動起動（systemd --user）の入れ方:\n\n'
		printf '  mkdir -p %s\n' "$(tilde_path "$_hb_dest")"
		printf '  ccs hub agent --print --unit service > %s/%s.service\n' \
			"$(tilde_path "$_hb_dest")" "$_hb_unit"
		if [ "$_hb_mode" = 'on' ]; then
			printf '  ccs hub agent --print --unit timer   > %s/%s.timer\n' \
				"$(tilde_path "$_hb_dest")" "$_hb_unit"
		fi
		printf '  systemctl --user enable --now %s.service\n' "$_hb_unit"
		if [ "$_hb_mode" = 'on' ]; then
			printf '  systemctl --user enable --now %s.timer\n' "$_hb_unit"
		fi
		printf '\n間隔 %s 秒 / モード %s。\n' "$CCS_HUB_AGENT_INTERVAL" "$_hb_mode"
		;;
	*)
		warn "ccs: この OS 向けの自動起動の雛形は用意していません: $(uname -s)"
		warn ''
		warn '任意のスケジューラから、次を定期実行してください（冪等です）:'
		warn "  $(ccs_self_path) hub up --quiet"
		exit "$EX_FAIL"
		;;
	esac
}

cmd_hub() {
	[ $# -ge 1 ] || {
		warn 'ccs: hub のサブコマンドを指定してください'
		warn ''
		warn '  ccs hub up        立てる（生きていれば何もしない）'
		warn '  ccs hub status    状態を見る'
		warn '  ccs hub restart   立て直す'
		warn '  ccs hub down      止める（自動起動も止まる）'
		warn '  ccs hub attach    乗り込む'
		warn '  ccs hub agent     自動起動の設定を出す'
		exit "$EX_USAGE"
	}

	_hb_sub=$1
	shift

	hub_normalize_home

	case $_hb_sub in
	up) cmd_hub_up "$@" ;;
	status) cmd_hub_status "$@" ;;
	restart) cmd_hub_restart "$@" ;;
	down) cmd_hub_down "$@" ;;
	attach) cmd_hub_attach "$@" ;;
	agent) cmd_hub_agent "$@" ;;
	*) die "$EX_USAGE" "hub: 未知のサブコマンド: ${_hb_sub}" ;;
	esac
}

# ---------------------------------------------------------------------------
# 入口
# ---------------------------------------------------------------------------

main() {
	[ $# -ge 1 ] || {
		usage >&2
		exit "$EX_USAGE"
	}

	_cmd=$1
	shift

	# **help / version / config は設定の検査を通さない。**
	# 設定が壊れているときこそ、値と直し方を見たい。
	# （config は表を出したあとに自分で検査する）
	case $_cmd in
	help | --help | -h | version | --version | -V | config) ;;
	*) validate_config ;;
	esac

	case $_cmd in
	new) cmd_new "$@" ;;
	ls) cmd_ls "$@" ;;
	attach) cmd_attach "$@" ;;
	kill) cmd_kill "$@" ;;
	gc) cmd_gc "$@" ;;
	restore) cmd_restore "$@" ;;
	hub) cmd_hub "$@" ;;
	resolve) cmd_resolve "$@" ;;
	config) cmd_config "$@" ;;
	help | --help | -h) usage ;;
	version | --version | -V) printf '%s\n' "$CCS_VERSION" ;;
	*)
		warn "ccs: 未知のサブコマンド: ${_cmd}"
		warn ''
		usage >&2
		exit "$EX_USAGE"
		;;
	esac
}

main "$@"
exit "$EX_OK"
