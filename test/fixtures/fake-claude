#!/bin/sh
#
# fake-claude — 本物の `claude` の代役。
#
# **integration テストが本物の Claude を起動しないための要。** これが無いと
# テストのたびに API を叩き、課金され、ログイン状態に依存し、実行のたびに
# 結果が変わる（AGENTS.md「テストの方針」）。
#
# 本物のうち、ccs が依存する部分だけを真似る:
#
#   1. 起動すると ${CCS_SESSIONS_DIR}/<pid>.json を書く
#      （実測した本物の形。docs/design.md §2.1）
#   2. tmux の中にいれば tmux フィールドを埋める
#   3. 終了時にその JSON を消す（本物もプロセスが死ねば消える）
#   4. `agents --json` で生きているセッションの配列を返す
#
# 本物と違って、アイドルするだけで何もしない。
#
# ## テスト用のつまみ（環境変数）
#
#   FAKE_CLAUDE_REGISTER_DELAY   登録までの待ち秒数。既定 0
#                                 ccs new のレジストリ待ちを検証するのに使う
#   FAKE_CLAUDE_NEVER_REGISTER   1 なら永遠に登録しない。タイムアウトの検証用
#   FAKE_CLAUDE_EXIT_AFTER       この秒数で自ら終了する。空なら終了しない
#                                 「ペインは生きているが claude は死んだ」の再現
#   FAKE_CLAUDE_EXIT_CODE        自ら終了するときの終了コード。既定 0
#   FAKE_CLAUDE_STATUS           registry に書く status。既定 idle
#   FAKE_CLAUDE_LOG              指定すると、受け取った引数をこのファイルに追記する
#                                 ccs が渡した引数を検証するのに使う
#   FAKE_CLAUDE_NO_BRIDGE        1 なら --remote-control を渡されても
#                                 bridgeSessionId を書かない。**実機で起きる**
#                                 「対話セッションとしては正常なのに Remote
#                                 Control が付かない」の再現（docs/hub.md）
#   FAKE_CLAUDE_BRIDGE_DELAY     bridgeSessionId を書くまでの待ち秒数。既定 0
#   FAKE_CLAUDE_ECHO             起動時にこの文字列をペインへ出す。
#                                 認証切れの画面（/login）の再現に使う
#   FAKE_CLAUDE_TRANSCRIPT       1 なら会話ログ（<CCS_PROJECTS_DIR>/<エンコード
#                                 した cwd>/<uuid>.jsonl）を書く。**本物は最初の
#                                 やり取りが起きてから書く**（実測）ので既定では
#                                 書かない。ccs restore がこれを読む
#   FAKE_CLAUDE_IGNORE_TERM      1 なら SIGTERM を無視して生き続ける。
#                                 ccs adopt の「頼んだのに終わらなかった」の再現
#   FAKE_CLAUDE_NO_STATUS        1 なら status キーごと書かない。**実測で
#                                 アプリ由来のセッションがこの形**（空文字とは別）

set -eu

FAKE_CLAUDE_VERSION='0.0.0-fake'

: "${CCS_SESSIONS_DIR:?fake-claude: CCS_SESSIONS_DIR が未設定です（本物の ~/.claude を守るため必須）}"

: "${FAKE_CLAUDE_REGISTER_DELAY:=0}"
: "${FAKE_CLAUDE_NEVER_REGISTER:=}"
: "${FAKE_CLAUDE_EXIT_AFTER:=}"
: "${FAKE_CLAUDE_EXIT_CODE:=0}"
: "${FAKE_CLAUDE_STATUS:=idle}"
: "${FAKE_CLAUDE_LOG:=}"
: "${FAKE_CLAUDE_NO_BRIDGE:=}"
: "${FAKE_CLAUDE_BRIDGE_DELAY:=0}"
: "${FAKE_CLAUDE_ECHO:=}"
: "${FAKE_CLAUDE_TRANSCRIPT:=}"
: "${FAKE_CLAUDE_IGNORE_TERM:=}"
: "${FAKE_CLAUDE_NO_STATUS:=}"

# ---------------------------------------------------------------------------
# 共通
# ---------------------------------------------------------------------------

now_ms() {
	printf '%s000\n' "$(date +%s)"
}

# JSON 文字列としての最低限のエスケープ。パスに " や \ が混じる異常系でも
# 壊れた JSON を書かないため（テストが「壊れた JSON」を検証したいときに、
# 意図せず壊れているのと区別がつかなくなる）。
json_escape() {
	printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

log_invocation() {
	[ -n "$FAKE_CLAUDE_LOG" ] || return 0
	printf '%s\n' "$*" >>"$FAKE_CLAUDE_LOG"
}

# ---------------------------------------------------------------------------
# agents --json — 生きているセッションの配列を返す
#
# 本物の `claude agents --json` に合わせる。ccs ls (S7) がこれを読む。
# ---------------------------------------------------------------------------

cmd_agents() {
	_json=''
	for _arg in "$@"; do
		[ "$_arg" = '--json' ] && _json=1
	done

	if [ -z "$_json" ]; then
		echo 'fake-claude: agents は --json のみ対応しています' >&2
		exit 2
	fi

	_first=1
	printf '[\n'
	for _f in "$CCS_SESSIONS_DIR"/*.json; do
		[ -e "$_f" ] || continue

		# 死んだプロセスの残骸は出さない。本物も生きているものしか並べない。
		_pid=$(sed -n 's/.*"pid":\([0-9]*\).*/\1/p' "$_f")
		[ -n "$_pid" ] || continue
		kill -0 "$_pid" 2>/dev/null || continue

		[ "$_first" = 1 ] || printf ',\n'
		_first=0
		printf '  '
		cat "$_f"
	done
	printf '\n]\n'
}

# ---------------------------------------------------------------------------
# 対話セッションの代役
# ---------------------------------------------------------------------------

REGISTRY_FILE=''

cleanup() {
	[ -n "$REGISTRY_FILE" ] && [ -f "$REGISTRY_FILE" ] && rm -f "$REGISTRY_FILE"
	return 0
}

write_registry() {
	_name=$1
	_session_id=$2
	_cwd=$3
	_bridge=${4:-}

	# tmux の中にいれば、本物と同じ形式（<session>:<window>.<pane>）で書く。
	# 本物がこれを自分で書くので、ccs は自分で対応づけを持たなくてよい。
	_tmux_field=''
	if [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ]; then
		_t=$(tmux display-message -p -t "$TMUX_PANE" '#{session_name}:#{window_id}.#{pane_id}' 2>/dev/null || true)
		[ -n "$_t" ] && _tmux_field="\"tmux\":\"$(json_escape "$_t")\","
	fi

	mkdir -p "$CCS_SESSIONS_DIR"
	_tmp="${CCS_SESSIONS_DIR}/.$$.tmp"

	# 一時ファイルに書いてから mv する。ccs のレジストリ待ちが
	# 「書きかけの JSON」を読んで落ちるのを防ぐ ── 本物も原子的に置き換える。
	{
		printf '{"pid":%s,' "$$"
		printf '"sessionId":"%s",' "$(json_escape "$_session_id")"
		printf '"cwd":"%s",' "$(json_escape "$_cwd")"
		printf '"startedAt":%s,' "$(now_ms)"
		printf '"version":"%s",' "$FAKE_CLAUDE_VERSION"
		printf '"kind":"interactive",'
		printf '"entrypoint":"fake-claude",'
		printf '%s' "$_tmux_field"
		printf '"name":"%s",' "$(json_escape "$_name")"
		# 本物は Remote Control に登録できると bridgeSessionId を埋め、
		# 登録できないと null のまま残す（実測）。両方を再現する。
		if [ -n "$_bridge" ]; then
			printf '"bridgeSessionId":"%s",' "$(json_escape "$_bridge")"
		else
			printf '"bridgeSessionId":null,'
		fi
		# **status キーごと無い形も作れる。** 実測 2026-08-30、アプリ由来の
		# セッションには status キーそのものが無かった。空文字とは別の状態で、
		# `ccs agents` はここを `-` として出す。
		if [ -n "$FAKE_CLAUDE_NO_STATUS" ]; then
			printf '"kind2":"no-status"}'
		else
			printf '"status":"%s"}' "$(json_escape "$FAKE_CLAUDE_STATUS")"
		fi
	} >"$_tmp"

	REGISTRY_FILE="${CCS_SESSIONS_DIR}/$$.json"
	mv "$_tmp" "$REGISTRY_FILE"
}

# 会話ログを書く。本物と同じ置き場所・同じ命名にする
# （`<CCS_PROJECTS_DIR>/<cwd の英数字以外を - に潰したもの>/<uuid>.jsonl`）。
#
# **中身は ccs が読むところだけ**を真似る: 会話の表示名（customTitle）と、
# どこで動いていたか（cwd）。--resume で呼ばれたときは追記する ── 本物も
# 同じファイルに書き足す（sessionId が変わらないため。実測）。
write_transcript() {
	_name=$1
	_session_id=$2
	_cwd=$3

	[ -n "$FAKE_CLAUDE_TRANSCRIPT" ] || return 0
	[ -n "${CCS_PROJECTS_DIR:-}" ] || {
		echo 'fake-claude: FAKE_CLAUDE_TRANSCRIPT には CCS_PROJECTS_DIR が要ります' >&2
		exit 2
	}

	_dir="${CCS_PROJECTS_DIR}/$(printf '%s' "$_cwd" | sed 's/[^A-Za-z0-9]/-/g')"
	mkdir -p "$_dir"
	_file="${_dir}/${_session_id}.jsonl"

	if [ ! -f "$_file" ] && [ -n "$_name" ]; then
		printf '{"type":"custom-title","customTitle":"%s","sessionId":"%s"}\n' \
			"$(json_escape "$_name")" "$(json_escape "$_session_id")" >>"$_file"
	fi
	printf '{"type":"user","cwd":"%s","sessionId":"%s"}\n' \
		"$(json_escape "$_cwd")" "$(json_escape "$_session_id")" >>"$_file"
}

cmd_interactive() {
	_name=''
	_session_id=''
	_rc=''

	while [ $# -gt 0 ]; do
		case $1 in
		-n | --name)
			_name=${2:-}
			shift 2 || shift
			;;
		--session-id)
			_session_id=${2:-}
			shift 2 || shift
			;;
		# 本物は --resume <id> でその会話を再開する。**sessionId は変わらない**
		# ので、ccs の hub restart --resume はそれを前提にしている。
		-r | --resume)
			_session_id=${2:-}
			shift 2 || shift
			;;
		# --remote-control は値が任意（`--remote-control` 単体でも
		# `--remote-control <名前>` でも通る）。本物と同じく、次の引数が
		# オプションでなければ名前として食う。
		--remote-control)
			_rc='(auto)'
			case ${2:-} in
			'' | -*) shift ;;
			*)
				_rc=$2
				shift 2
				;;
			esac
			;;
		# 値を取るが中身は見ないもの。本物に渡している間は落ちてはいけない。
		--permission-mode | --model | --effort | --agent | --add-dir | --settings)
			shift 2 || shift
			;;
		--*)
			shift
			;;
		*)
			shift
			;;
		esac
	done

	[ -n "$_session_id" ] || {
		echo 'fake-claude: --session-id が渡されていません' >&2
		exit 2
	}
	[ -n "$_name" ] || _name='fake'

	# **HUP を明示的に捕まえる。** tmux は kill-session / kill-pane のとき
	# ペインのプロセスに SIGHUP を送る。EXIT の trap があれば足りると思いがちだが、
	# **EXIT が走るかどうかはシェル実装に依る** ── macOS の /bin/sh は bash 3.2 で
	# 走り、Linux の /bin/sh は dash で走らない。落ちなかった側ではレジストリの
	# 残骸が消えず、次に立てたセッションと 2 件並ぶ。実際にそれで CI だけが
	# 落ちていた（restore の 2 件、2026-08-23）。
	trap 'cleanup' EXIT
	trap 'cleanup; exit 129' HUP
	if [ -n "$FAKE_CLAUDE_IGNORE_TERM" ]; then
		# **頼まれても終わらない。** `ccs adopt` は元が終わるのを待って
		# から立てるので、「頼んだのに終わらなかった」を作るのに要る。
		trap '' TERM
	else
		trap 'cleanup; exit 143' TERM
	fi
	trap 'cleanup; exit 130' INT

	# ペインに出す文字列。認証切れの画面を作るのに使う。
	[ -n "$FAKE_CLAUDE_ECHO" ] && printf '%s\n' "$FAKE_CLAUDE_ECHO"

	if [ -n "$FAKE_CLAUDE_NEVER_REGISTER" ]; then
		# 登録しないまま生き続ける。ccs 側のタイムアウトを検証するため。
		while :; do sleep 1; done
	fi

	# `[ ] && sleep` と書くと set -e の AND-OR 例外に依存する読みにくい形になる。
	# 後から「バグだ」と直されないよう if で書く。
	if [ "$FAKE_CLAUDE_REGISTER_DELAY" -gt 0 ] 2>/dev/null; then
		sleep "$FAKE_CLAUDE_REGISTER_DELAY"
	fi

	# Remote Control を頼まれていて、かつ「付かない」つまみが無ければ、
	# bridgeSessionId を埋める。遅延を入れられるのは、ccs 側の待ちを
	# 検証するため。
	_bridge=''
	if [ -n "$_rc" ] && [ -z "$FAKE_CLAUDE_NO_BRIDGE" ]; then
		if [ "$FAKE_CLAUDE_BRIDGE_DELAY" -gt 0 ] 2>/dev/null; then
			write_registry "$_name" "$_session_id" "$PWD" ''
			sleep "$FAKE_CLAUDE_BRIDGE_DELAY"
		fi
		_bridge="session_fake$$"
	fi

	write_registry "$_name" "$_session_id" "$PWD" "$_bridge"
	write_transcript "$_name" "$_session_id" "$PWD"

	if [ -n "$FAKE_CLAUDE_EXIT_AFTER" ]; then
		sleep "$FAKE_CLAUDE_EXIT_AFTER"
		cleanup
		exit "$FAKE_CLAUDE_EXIT_CODE"
	fi

	# アイドル。1 秒刻みなのは、trap がすぐ効くようにするため
	# （長い sleep 中は shell がシグナルを処理しない）。
	while :; do sleep 1; done
}

# ---------------------------------------------------------------------------
# 入口
# ---------------------------------------------------------------------------

log_invocation "$@"

case ${1:-} in
agents)
	shift
	cmd_agents "$@"
	;;
--version | -v)
	printf '%s (fake-claude)\n' "$FAKE_CLAUDE_VERSION"
	;;
*)
	cmd_interactive "$@"
	;;
esac
